triggerall = statetype = A
triggerall = var(0) = 1
triggerall = ctrl
triggerall = stateno != 132
trigger1 = p2statetype = A
trigger2 = (enemy, NumProj >= 1)
trigger3 = (enemy,numhelper >= 1)

