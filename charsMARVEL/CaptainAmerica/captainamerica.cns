trigger1 = 1
y = 0

[State 101, ChangeAnim] ;AvX style run
type = ChangeAnim
triggerall = var(16) = 1
trigger1 = anim != 101
value = 101

[State 101, VelSet]
type = VelSet
trigger1 = AnimElem = 1
x = 7
y = 0

[State 101, VelMul]
type = VelMul
triggerall = var(16) = 0
trigger1 = AnimElem = 9
x = .3

[State 101, 2]
type = AssertSpecial
triggerall = var(16) = 1
trigger1 = 1
flag = NoWalk

[State 101, 3]
type = AssertSpecial
triggerall = var(16) = 1
trigger1 = 1
flag = NoAutoTurn

[State 101, Width]
type = Width
trigger1 = 1
value = 10,0

[State 101, Dash Sound]
type = PlaySnd
triggerall = var(16) = 0
trigger1 = Time = 1
value = 10,2

[State 101, Footstep Sound]
type = PlaySnd
triggerall = var(16) = 1
trigger1 = animelem = 1
trigger2 = animelem = 6
value = 10,3

[State 101, Cancel into walking back]
type = ChangeState
triggerall = random > 900
triggerall = random < 910
trigger1 = Command = "holdback" && Time > 3
value = 20
