[State 101, Cancel into crouching]
type = ChangeState
triggerall = random > 800
triggerall = random < 810
trigger1 = Command = "holddown"
value = 10
ctrl = 1

[State 101, Cancel into jumping]
type = ChangeState
triggerall = random > 700
triggerall = random < 710
trigger1 = Command = "holdup"
value = 40
ctrl = 1

[State 101, Cancel into Stop]
type = ChangeState
triggerall = var(16) = 1
trigger1 = p2dist x <= 100
value = 0
ctrl = 1

[State 101, ChangeState]
type = ChangeState
triggerall = var(16) = 0
trigger1 = AnimTime = 0
value = 0
ctrl = 1

