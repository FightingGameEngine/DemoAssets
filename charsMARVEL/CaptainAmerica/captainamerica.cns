;Variable List
;Var(0) = Temp
;Var(6) = Super Jump
;Var(7) = Taunt Phrase
;Var(8 - 11) = Combo & Announcer System
;Var(12-13) = Super Jump
;Var(14) = Dropped Shiled Velocity
;Var(15) = Stars n' Stripes Move Contact
;Var(16) = Shield Type (MvC3 1 or MvC2 0)
;var(17) = Stars n' Stripes Counter
;Var(19) = Move before intro
;Var(20) = Hyper Var
;Var(29) = HitFreeze Time (For shield Gethits)
;Var(30) = Recovery Roll
;Var(31) = Grab Shield
;Var(32) = Grab Shield
;Var(33) = Grab Shield
;var(39) = Shiled Throw Counter
;Var(40) = Shield
;Var(41) = Gethit with Shield
;Var(42) = Drop Shield when Forced into Custom State (1,0)
;var(43) = Shield is dropped  (9696)
;var(44) = Shows the current statenum of the Shield

;fvar(0); Temp
;fvar(25); AvX is normal attack
;fvar(26); AvX is special attack
;fvar(27); AvX is hyper attack
;fvar(28); AvX Hitcount
;fvar(29); AvX style OTG
;fvar(30); AvX style hit recognition
;fvar(31); AvX style lie down after hit (30 ticks)
;===========================================================================
;10000 = Shield Statedef

;20000 = Shield lie idle, there are two versions, one for the shield to
;remain on the ground until picked up and another which will return the
;shield to Cap.

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2;s7702
guard.sparkno = 40
KO.echo = 0
volume = 200
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 18
air.front = 22
height = 60
attack.dist = 160
attack.width = 4,4
proj.dist = 90
proj.attack.dist = 90
proj.doscale = 0
head.pos = 1, -83
mid.pos = 1, -53
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -2.7
run.fwd  = 5
run.back = -5,0
jump.neu = 0,-9
jump.back = -3.7
jump.fwd = 4.4
runjump.back = -4.4,-8.1
runjump.fwd = 3.6,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.55

[Movement]
airjump.num = 1
;airjump.height = 35
yaccel = .41
stand.friction = .80
crouch.friction = .80
air.friction = .80

[Quotes]
victory1 = "Rest easy soldier, your time is over."
victory2 = "For freedom and justice!"

;[ja.Quotes]
;victory1 = ""

;---------------------------------------------------------------------------
; Dash Forward

[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
ctrl = 0

[State 100, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 100, CtrlSet]
type = CtrlSet
trigger1 = var(16) = 1
value = 1

[State 100, ChangeAnim] ;AvX style run
type = ChangeAnim
triggerall = var(16) = 1
trigger1 = anim != 101
value = 101

[State 100, VelSet]
type = VelSet
trigger1 = AnimElem = 1
x = 7
y = 0

[State 100, VelMul]
type = VelMul
triggerall = var(16) = 0
trigger1 = AnimElem = 9
x = .3

[State 100, 2]
type = AssertSpecial
triggerall = var(16) = 1
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
triggerall = var(16) = 1
trigger1 = 1
flag = NoAutoTurn

[State 100, Width]
type = Width
trigger1 = 1
value = 10,0

[State 100, Dash Sound]
type = PlaySnd
triggerall = var(16) = 0
trigger1 = Time = 1
value = 10,2

[State 100, Footstep Sound]
type = PlaySnd
triggerall = var(16) = 1
trigger1 = animelem = 1
trigger2 = animelem = 6
value = 10,3

[State 100, Cancel into walking back]
type = ChangeState
trigger1 = Command = "holdback" && Time > 3
value = 20
ctrl = 1

[State 100, Cancel into crouching]
type = ChangeState
trigger1 = Command = "holddown"
value = 10
ctrl = 1

[State 100, Cancel into jumping]
type = ChangeState
trigger1 = Command = "holdup"
value = 40
ctrl = 1

[State 100, Cancel into Stop]
type = ChangeState
triggerall = var(16) = 1
trigger1 = Command != "holdfwd"
value = 0
ctrl = 1

[State 100, ChangeState]
type = ChangeState
triggerall = var(16) = 0
trigger1 = AnimTime = 0
value = 0
ctrl = 1

