; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1200			;Amount of life to start with
power = 3000		;Amount of maximum power
attack = 120		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 1.1		;Horizontal scaling factor.
yscale = 1.2			;Vertical scaling factor.
ground.back = 35    ;Player width (back, ground)
ground.front = 40    ;Player width (front, ground)
air.back = 18        ;Player width (back, air)
air.front = 18       ;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too
head.pos = -5, -100	;Approximate position of head
mid.pos = -5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.8      ;Walk forward
walk.back = -3.4     ;Walk backward
run.fwd  = 5.6, 0    ;Run forward (x, y)
run.back = -5.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-12    ;Neutral jumping velocity (x, y)
jump.back = -3.25;-2.55    ;Jump back Speed (x, y)
jump.fwd = 3.25;2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-3;-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-3;8.1      ;.
airjump.neu = 0,-3;8.1      ;.
airjump.back = -4;-2.55      ;Air jump speeds (opt)
airjump.fwd = 4;2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 50  ;Minimum distance from ground before you can air jump (opt)
yaccel = .50         ;Vertical acceleration
stand.friction = .70  ;Friction coefficient when standing
crouch.friction = .70 ;Friction coefficient when crouching

;======================================================

[Quotes]
victory1 = "You idiot... it doesn't let the lizard out... it keeps him in!"
victory2 = "When Lizard dumb, Lizard your prey. Lizard take monkey brain. Lizard not dumb. You are prey"
victory3 = "I shall over come this evolutionary setback. I will be the Lizard again, inside and out"
victory4 = "This will restore me to my rightful form. But is that... What I really want?"
victory5 = "NO! I mustn't tell him! No one can ever know. The cure worked. My mind's been restored"
victory6 = "And I know why I'm here, For the choices I've made. This is my prison, My penance, My hell, and i deserve it"
victory7 = "Not a monster. I'm Curtisss Connorsss. And I will never let the monstersss win again"
victory8 = "It's always about you, Don't try to speak, You've already said too much"
victory9 = "I work in darkness. The Lizard wants out. It's time I stopped ignoring him"
victory10 = "Don't you just love the scientific method?"
victory11 = "Do you have any idea what you really are?"
victory12 = "Ready to play God?"
victory13 = "At Oscorp, They called me a mad scientist, I knew there were risks"
victory14 = "I was mocked for my theories. Not just in the community at large, but also at OsCorp"
victory15 = "When we bred the spiders, The result were beyond encouraging, They were spectacular"
victory16 = "I was going to change the lives of millions. Including my own. Then I.. I.. I was angry"
victory17 = "If you want the truth, come and get it!"
victory18 = "Did you know there's rumor of a new species in New York? Beautiful but quite large."
victory19 = "This new species, it's not yet classified. But it can be aggressive... if threatened"
victory20 = "Extraordinary. How did you come up with this?"
victory21 = "That, changing like the snake, I might be free to cast off flesh wherein I dwell confined"
victory22 = "In case you're wondering, I'm a southpaw, and a scientist"
victory23 = "I spent my life as a scientist trying to create a world without weakness, without outcasts"
victory24 = "I sought to create a stronger human, but there's no such thing"
victory25 = "Why be a human, when we can be so much more? Faster, stronger, smarter. This is my gift to you"
victory26 = "Let's not do that again."
victory27 = "No... no... no! Who? Spider-Man? Oh, dear God. Not more. What did I do?"
victory28 = "Yes, yes, of course. A sample of the regeneration serum, I can engineer an antidote"
victory29 = "the Lizard...sorry 'I' had another lab down in the sewer, I will set things right again"
victory30 = "My regeneration serum is finally ready to test and what better guinea pig then myself"
victory31 = "I can't allow a twist of fate to undo the natural order when science can correct it"
victory32 = "Ow! Stings more than I expected. I feel... something... happening"
victory33 = "Better take this, just in case your math is off"
victory34 = "I am the world's most foremost authority in herpetology, That's a study of reptiles"
victory35 = "It enhances aggression...It seems to like you"
victory36 = "My class is over. See me standing here? Better do your research, or I'm failing you"
victory37 = "Human beings are weak, pathetic, feeble-minded creatures"


;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = PlaySnd
trigger1 = time = 0
value = 170,0
channel=0
volume=255

[State 170]
type = AssertSpecial
trigger1 = Time < 280
flag = roundnotover

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

