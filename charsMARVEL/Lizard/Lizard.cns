;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; Intros
[Statedef 190]  ; intro selector
type = S
ctrl = 0
VelSet = 0,0

[State 191]
type = Explod
triggerall = NumPartner = 1
trigger1 = id > (partner, id)
trigger1 = roundstate < 2
pos = 0,-100
postype = p1
bindtime = 1
sprpriority = 4
anim = 201
removetime = 100
facing = (facing)
ownpal = 1

[State 191]
type = Explod
triggerall = NumPartner = 1
trigger1 = id > (partner, id)
trigger1 = roundstate < 2
trigger1 = TeamSide = 2
pos = 0,-100
postype = p1
bindtime = 1
sprpriority = 5
anim = 202
removetime = 100
facing = (facing)
ownpal = 1

[State 190,intro decider]
type = ChangeState
trigger1 = time = 0
value = 191+(random%3)     ; change the 1 to however many intros you have

