;---------------------------------------------------------------------------
; Get Air Combo Finish
[Statedef 660]
type    = A
movetype= H
physics = N
velset = 0,0

[state 660, turn]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[state 660, VelSet]
type = velset
trigger1 = time = 0
x = -12
y = 16

[State 660, ChangeAnim] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 660, ChangeAnim] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[state 660, velAdd]
type = veladd
trigger1 = 1
y = 0.4

[State 660, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 661

