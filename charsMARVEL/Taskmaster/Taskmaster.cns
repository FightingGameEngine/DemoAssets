;===========================================================================
;Taskmaster cns
;
;based on
;				Super Marvel vs. Capcom - Eternity of Heroes - Constants Template V.9
;				by Acey
;===========================================================================

;==List of Variables==
;
;Var (0) = Super Jump
;Var (1) = Intro Selector
;Var (2) = Super Combo (Removed)
;var (3) = 
;Var (4) = Web Swing Groung is already used
;Var (5) = Web Swing Air is already used
;Var (6) = Arrows generation pos
;Var (7) = Floor Possition
;Var(8 - 10) = Announcer Text
;Var (11) = Super Jump Direction
;Var (12) = Super Jump
;Var (17) = Screen Pack
;Var (21) = Combo Mute
;Var (28) = Taunt
;Var (30) = Recovery Roll
;Var (59) = AI On

;ｆvar (1) = hit time factor
;ｆvar (3) = web swing inertia

[Data]
life = 1200
power = 3000
attack = 110
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = s7700 ;Mugen default is 2
guard.sparkno = s20050 ;s6767 ;Mugen default is 40
KO.echo = 0
volume = 555
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1;0.83;1
yscale = 1
ground.back = 40;20
ground.front = 40;20
air.back = 40;18
air.front = 40;22
height = 80
attack.dist = 160
attack.width = 4,4
proj.dist = 90
proj.attack.dist = 90 
proj.doscale = 0
head.pos = 1, -83
mid.pos = 1, -53
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd = 2.2;3.6
walk.back = -2.5
run.fwd = 12,0;5,0
run.back =-8,-3 ;-8,0;-3
jump.neu = 0,-9.0
jump.back = -3.7
jump.fwd = 3.2
runjump.fwd = 4.4
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5
airjump.back = -2.55

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .48;.41
stand.friction = .80
crouch.friction = .80
air.friction = .80

[Quotes];English
victory1 = "Too many ways to beat you"
victory2 = "You wish you could fight like me"
victory3 = "I'm a Secret Agent Man!"
victory4 = "Got paid good money to defeat you"
victory5 = "That was some asskicking I just gave you"
victory6 = "You need fighting lessons. I'm available to teach every other Sunday"
victory7 = "Hawkeye wishes he was as good with a bow as me"
victory8 = "Gimme all your money or I'll do that again!"
victory9 = "My shield looks better than Cap's"
victory10 = "So many people to kill, so little time"
victory11 = "Maybe you need some more weapons"
victory12 = "I'll send you a bill for the lesson!"
victory13 = "I do this for the cash, not for the thrills"
victory14 = "I'm just so much better than you...you had no chance"
victory15 = "'Best that there is', sounds like a good business card"
victory16 = "You'll look good stuffed and mounted over my fireplace"
victory17 = "I told ya 100 times, you can't work for me cause killing my students is bad for business"
victory18 = "Don't take it personally when I bullseye an arrow through your skull"

