[State 5080, 2]
type = VarAdd
triggerall = Var(30)= 1
trigger1 = time = 0
trigger1 = (anim = [6081,6089]) || (anim = [6111,6119])
trigger1 = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

