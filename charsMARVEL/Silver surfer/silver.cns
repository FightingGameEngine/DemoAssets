value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
;anim = 11
sprpriority = 0

[State 20, ChangeAnimFwd]
type = ChangeAnim
triggerall = Var(30)= 0
trigger1 = time = 0
value = 11

[State 20, ChangeAnimBack]
type = ChangeAnim
triggerall = Var(30)= 1
trigger1 = time = 0
value = 14

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = Var(30)= 0
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 0, ChangeAnim]
type = ChangeAnim
trigger1  = Var(30)= 1
trigger1 = p2bodydist x < 0
value = 8

[State 0, ChangeAnim]
type = ChangeAnim
trigger1  = Var(30)= 1
trigger1 = p2bodydist x >= 0
value = 14

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = Var(30)= 1
trigger1 = Anim = 8 && AnimTime = 0
value = 14

