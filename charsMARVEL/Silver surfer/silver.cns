[State 5080, 1] ;Set default anim
type = VarSet
triggerall = Var(30)= 1
trigger1 = time = 0
sysvar(2) = ifelse (GetHitVar(yvel) = 0, 6080, 6090)

[State 5080, 2]
type = VarAdd
triggerall = Var(30)= 0
trigger1 = time = 0
trigger1 = (anim = [5081,5089]) || (anim = [5111,5119])
