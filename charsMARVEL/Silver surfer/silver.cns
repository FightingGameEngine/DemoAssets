triggerall = var(7)
trigger1 = var(8) = [13,16]
fv = 1
value = .28
ignorehitpause = 1

[State -2, Final Decrease]
type = VarSet
triggerall = var(7)
trigger1 = var(8) > 16
fv = 1
value = .24
ignorehitpause = 1

