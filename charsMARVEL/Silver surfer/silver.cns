trigger7 = Helper(3512), MoveHit
trigger8 = NumHelper(3901) > 0
trigger8 = Helper(3901), MoveHit
trigger9 = NumHelper(1802) > 0
trigger9 = Helper(1802), MoveHit
v = 13
value = 1
ignorehitpause = 1

