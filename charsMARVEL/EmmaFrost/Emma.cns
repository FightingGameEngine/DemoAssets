;var(0) =contador de tempo
;var(1) =contador de hit para a palavra
;var(2) =Magia fraca, média ou forte.
;var(3) =Air Combo
;var(4) =hit Counter / Pantonerre: quantidade de hits do hiper
;var(5) =Número de helpers / projéteis do adversário
;var(6) =Número de helpers / projéteis ameaçadores
;var(7) =Congela power bar no Especial infinito
;var(8) =Plasma Combo (extensão)
;var(9) =Power Up: Duração (1000)
;var(10)=Super pulo: deslocamento horizontal
;var(11)=Nível de dificuldade
;var(13)=Força do combo (hits)
;var(14)=Contador do Advanced-Guard
;var(17)=Estou em DOS (par) ou WinMugen? (ímpar) - número do screen pack
;var(18)=Danger - para o contador de hit
;var(19)=Score
;var(20)=AI
;var(21)=Blindagem
;var(25)= ZVitor Projeção
;var(26)= ZVitor Projeção cima baixo
;var(27)= ZVitor Projeção Hits
;var(38)=TAG-TEAM:ajuda
;var(50)-var(59)=blindagem
;
; Emma Frost's constants and state file.

[Data]
power = 3000
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno= 2
guard.sparkno=40
KO.echo = 0
volume = 0
IntPersistIndex=0 
FloatPersistIndex=0 

[Size]
xscale = .98
yscale = .98
ground.back = 15     
ground.front = 20
air.back = 15        
air.front = 20       
height = 90
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = 6,-93
mid.pos = 9,-77
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
walk.fwd  = 3.2      
walk.back = -2.8     
run.fwd  = 6, 0    
run.back = -7.5,-2.8 
jump.neu = 0,-10
jump.back =  -3.5,-10
jump.fwd = 4,-10
runjump.fwd = 5,-9
runjump.back = -3.5,-10
airjump.neu = 0,-8.3	;.
airjump.back = -2.9	;Air jump speeds (opt)
airjump.fwd = 2.9   ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 40
yaccel = .5
stand.friction = .80
crouch.friction = .83

[Quotes]
victory1 = "The harder you resist, the more this will hurt."
victory2 = "I don't want to hurt you, my dear. I want us to be ... friends."

