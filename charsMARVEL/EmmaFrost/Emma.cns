;Acha a componente X do vetor Player, EnemyNear
;Fórmula para achar as componentes de um vetor AB
;V(x) = B(x) - A(x)
;V(y) = B(y) - A(y)
[State 1640, Componente X]
Type = VarSet
Trigger1 = anim=1020 && time = 30
fvar(3) = (Enemy, Pos X - Pos X) * Facing ;Ajusta a direção da componente por facing

;Acha a componente Y do vetor Player, EnemyNear
[State 1640, Componente Y]
Type = VarSet
trigger1 = anim=1020 && time = 30
fvar(4) = (Enemy, pos Y) - (Pos Y)

;Encontra o tamanho do vetor Player, EnemyNear(0)
;Fórmula do módulo de um dado vetor AB:
;|AB| = (AB(x)^2 + AB(y)^2)^1/2
[State 1640, Normal]
Type = VarSet
trigger1 = anim=1020 && time = 30
fvar(5) = Exp(0.5*ln((fvar(3) * fvar(3))+(fvar(4) * fvar(4))))

