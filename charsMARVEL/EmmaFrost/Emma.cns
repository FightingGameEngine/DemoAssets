first = 21
last = 59
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, 3] ;Intro
type = ChangeState
;triggerall = teamside = 2
trigger1 = roundno = 1
value = 190


