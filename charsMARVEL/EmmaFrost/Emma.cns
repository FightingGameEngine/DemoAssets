[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse(enemynear,name = "SentinelStage",ifelse(enemynear,numhelper>1,const(velocity.walk.fwd.x),5),const(velocity.walk.fwd.x))-var(21)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)+var(21)

[State 20, 3]
type = ChangeAnim
triggerall = enemynear, name != "helibonus"
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5 && Anim != 60020 && Anim != 60005 
trigger2 = (Anim = 5 || anim = 60005) && AnimTime = 0 ;Turn anim over
value = 20 + 60000*var(21)

[State 20, 4]
type = ChangeAnim
triggerall = enemynear, name != "helibonus"
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5 && Anim != 60021 && Anim != 60005 
trigger2 = (Anim = 5 || anim = 60005) && AnimTime = 0 ;Turn anim over
value = 21 + 60000*var(21)

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = enemynear, name = "helibonus"
trigger1 = anim != 0
value = 0 + 60000*var(21)

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40+60000*var(21)
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;--------------------------------------------------------------------------- 
; Jump Up 
[Statedef 50]; Pulo com virada 
type    = A 
physics = A 

[State 50, VelSet]
type = VelSet
triggerall = enemynear,movetype = H
trigger1 = prevstateno = 620 || prevstateno = 650
y = 20

[State 50, 1] 
type = Turn 
trigger1 = Time = 1 
trigger1 = p2dist X < -5 

[State 50, 2] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 50, 3] 
type = ChangeAnim 
trigger1 = Time = 0 && var(21)=0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)) 

[State 50, 3] 
type = ChangeAnim 
trigger1 = Time = 0 && var(21)=1
value = ifelse((vel x)=0, 60041, ifelse((vel x)>0, 60042, 60043)) 

[State 50, 4] 
type = ChangeAnim 
trigger1 = Vel y > -2 
trigger1 = SelfAnimExist((anim+60000*var(21)) + 3) 
persistent = 0 
value = Anim+60000*var(21) + 3 

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47+60000*var(21)

[State 52]
type = Explod
trigger1 = Time = 0
anim = 8510
sprpriority = -2
pos = 0,0
ownpal = 1

[State 52, Landing Sound]
type = PlaySnd
trigger1 = Time = 0
value = S8,1


[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;--------------------------------------------------------------------------- 
; RUN_FWD 
[Statedef 100] 
type    = S
movetype = I
physics = N
anim = 100
sprpriority = 1
VelSet= const(velocity.run.fwd.x);-const(velocity.run.fwd.x)*(0.25*var(21)),const(velocity.run.fwd.y)

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
trigger2 = animelem = 7
trigger3 = animelem = 11
trigger4 = animelem = 15
value = S0,8

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = !Var(59)
trigger1 = command != "holdfwd";Time = 135
value = 0
ctrl = 1


[State 100, 4]
type = ChangeState
triggerall = Var(59)
trigger1 = time > 15
value = 0
ctrl = 1

; RUN_BACK 
[Statedef 105] 
type = A 
physics = N 
ctrl = 0 
anim = 105 + 60000 * var(21)
VelSet= const(velocity.run.back.x)-const(velocity.run.back.x)*(0.25*var(21)),0

[State 105, 1] 
type = StateTypeSet
trigger1 = time = 0 && const(velocity.run.back.y)=0
statetype = S

[State 100, 3] ;explod de controle de corrida
type = null;Explod
trigger1 = time = 0
anim = 101
id=101
postype = p1 
removeongethit=1
removetime=-2


[State 105, AssertSpecial] 
type = AssertSpecial 
trigger1 = 1 
flag = NoWalk 
flag2 = NoAutoTurn 

[State 155, 2] 
type = VelAdd 
trigger1 = pos y < 0 
y = Const(movement.yaccel) 

[State 0, Explod]
type = null;Explod
triggerall = anim = 105
trigger1= timemod = 3,1
anim = 62
ID = 62
pos = 20,0
postype = p1  ;p2,front,back,left,right
removetime = -2
scale = 1,1
sprpriority = 10
ownpal = 1


[State 105, 1] 
type = StateTypeSet
trigger1 = command != "holdback"
trigger3 = command = "holdback" && command = "holdup"
trigger2 = pos y > 0
physics = S
statetype = S

[State 105, 1] 
type = posset
trigger1 = command != "holdback"
trigger3 = command = "holdback" && command = "holdup"
trigger2 = pos y > 0
y = 0

[State 105, 1] 
type = StateTypeSet
trigger1 = anim=106 || anim=60106
physics = S

[State 105, 1] 
type = ChangeState 
trigger1 = command != "holdback"
trigger2 = command = "holdback" && command = "holdup"
value = 0 
ctrl=1 

[State 100, 6] 
type = Changeanim
trigger1 = anim = 105 + 60000 * var(21)
trigger1 = animtime = 0 
trigger2 = anim!=106 && anim!=60106 && command != "holdback" && var(20)!=1 
value = 106 + 60000 * var(21)

[State 100, 6] 
type = ChangeState 
trigger1 = anim=106 || anim=60106
trigger1 = animtime = 0 
value = 0 
ctrl=1 

[Statedef 106]
type = A
physics = N
ctrl = 0
anim = 107
VelSet= 0,0

[State 52, Landing Sound]
