;---------------------------------------------------------------------------
; Pause Before running onto screen
[Statedef 108]
type = S
movetype= I
physics = N
velset = 0, 0
ctrl = 0
anim = 108
sprpriority = 2

[State 0, PosSet]
type = PosSet
trigger1 = time = 0
x = backedgebodydist
y = 0

[State 655, ScreenBound]
type = ScreenBound
trigger1 = p2movetype = H
value = 0
movecamera = 0,0



[state 659, run]
type = ChangeState
trigger1 = time > 25 && enemynear, vel x = 0;pos y >= 0
trigger2 = time >= 50
value = 109 ;101 ;run back onscreen state
ctrl = 0


;---------------------------------------------------------------------------
;Run onto screen
[Statedef 109]
type    = S
physics = S
anim = 109
sprpriority = 3


[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 2 & time > 0 && time <= 20
x = 19
y = 0
ignorehitpause = 1
;persistent =

[State 0, VelAdd]
type = VelAdd
trigger1 = animelem >=4
x = .5
ignorehitpause =1
;persistent =


[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 100, 10


[State 101, 4]
type = ChangeState
trigger1 = animtime = 0
value = 11
ctrl = 1



