;---------------------------------------------------------------------------
; Wakeup Forward
[Statedef 5155]
type    = L
movetype= I
physics = N

[State 5155, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5155 + (anim % 10))
value = 5155

[State 5155, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5155 + (anim % 10))
value = 5155 + (anim % 10)

[State 5155, VelSet]
type = VelSet
trigger1 = animelem = 1
x = 7
y = 0


[State 5155, 4]
type = HitFallSet
trigger1 = Time = 0
value = 1

[State 5155, 5] ;Can't be thrown right after getting up
type = NotHitBy
trigger1 = AnimTime = 0
value = , NT,ST,HT
time = 10

[State 5155, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0
value2 = SCA
time = 10



[State 5155, 7]
type = changestate
trigger1 = AnimTime = 0
Value = 0
ctrl = 1


