;Hypers
[State -3, Psi-Malestrom]
type = ChangeState
value = 3000
triggerall = Var(59) = 1
triggerall = statetype != A
triggerall = power >= 2000
trigger1 = ctrl
trigger1 = enemynear,movetype = A
trigger1 = p2bodydist X <= 30
trigger1 = p2bodydist Y = [0,-150]
trigger1 = random = [600,900]
trigger2 = stateno = 200 && movehit || stateno = 210 && movehit || stateno = 440 && movehit || stateno = 420 && movehit
trigger2 = random = [400,500]

[State -3, Psi-Thrust]
triggerall = Var(59) = 1
type = ChangeState
value = 2000
triggerall = StateType = S
triggerall = power >= 1000
trigger1 = ctrl
trigger1 = stateno = 220 && movecontact >= 1 || 210 && movecontact >= 1 || 250 && movecontact >= 1 || 410 && movecontact >= 1
trigger1 = random = [100,800]

