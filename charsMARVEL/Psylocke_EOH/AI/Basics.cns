;Auto Blocking AI from the tutorial by K3nShiN

; ==========================
; AI Standing Guard
; ==========================
[State -3]
type = ChangeState
triggerall = var(59) = 1 ;AI trigger used
triggerall = Statetype != A ;Player is not in the air
triggerall = P2statetype != C ;Player is not crouching
triggerall = Statetype = S && movetype = I;Player is currently standing
triggerall = P2Movetype = A ;Opponent is attacking
triggerall = Pos Y != [-1,-999]
triggerall = ctrl = 1
trigger1 = random = [200,800] ;triggers at 80% probability
trigger1 = 1
value = 130 ;Default standing guard state

; =============================
; AI Stand to Crouch Guard Transition
; =============================
[State -3]
type = ChangeState
triggerall = var(59) = 1
triggerall = StateType != A
triggerall = P2statetype = C
triggerall = P2Movetype = A
triggerall = Pos Y != [-1,-999]
trigger1 = stateno = 150
trigger1 = 1
value = 152

; =============================
; AI Crouching Guard
; =============================
[State -3]
type = ChangeState
triggerall = var(59) = 1
triggerall = StateType != A
triggerall = P2statetype = C
triggerall = P2Movetype = A && movetype = I
triggerall = Pos Y != [-1,-999]
triggerall = ctrl = 1
trigger1 = random = [200,800]
trigger1 = 1
value = 131

; =============================
; AI Crouch to Stand Guard Transition
; =============================
[State -3]
type = ChangeState
triggerall = var(59) = 1
triggerall = Statetype != A
triggerall = P2statetype != C
triggerall = P2Movetype = A
trigger1 = 1
trigger1 = stateno = 152
value = 150

; =============================
; AI Aerial Guard
; =============================
[State -3]
type = ChangeState
triggerall = var(59) = 1
triggerall = Statetype = A && movetype = I
triggerall = P2Movetype = A
triggerall = ctrl = 1
trigger1 = random = [200,800]
trigger1 = 1
value = 132


[State -3, Crouch]
type = ChangeState
value = 11
triggerall = Var(59) = 1
triggerall = statetype != A
trigger1 = ctrl
trigger1 = enemynear, statetype = C
trigger1 = random = [301,400]


[State -3, Dash]
type = ChangeState
value = 100
