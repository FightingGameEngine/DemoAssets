
;AI (Basics)
[Statedef -3]


[State -3, AI]
type = VarSet
triggerall = Var(59) = 0
triggerall = roundstate >= 1
trigger1 = command = "AI_00" ^^ command = "AI_30"
trigger2 = command = "AI_01" ^^ command = "AI_31"
