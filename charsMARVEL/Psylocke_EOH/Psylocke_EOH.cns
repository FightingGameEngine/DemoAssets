guard.sparkno = s935;Y-offset for the spark rel. to p1
sparkxy = -35, -90		;X-offset for the "hit spark" rel. to p2,
hitsound = s200, 30			;Sound to play on hit
guardsound = s6300, 0			;Sound to play on guard
ground.type = High		;Type: High, Low, Trip (def: Normal)
