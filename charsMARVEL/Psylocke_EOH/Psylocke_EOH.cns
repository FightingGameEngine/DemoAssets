Trigger1 = p2stateno = 223 || p2stateno = 821 || p2stateno = 891 && (time > 0) && (time <= 3)
helpertype = normal ;player
name = "Slam"
stateno = 225
pos = 0,0
postype = p2    ;p2,front,back,left,right
facing = 1
size.xscale = 0.7
size.yscale = 1
supermovetime = 999
pausemovetime = 999


;P2 Custom Slam FX # 2
[State -2, Helper]
type = Helper
Triggerall = enemynear, movetype = H && (time > 0) && (time <= 3);&& movehit
Trigger1 = enemynear, anim = 5100
helpertype = normal ;player
name = "Slam"
stateno = 225
pos = 0,0
postype = p2    ;p2,front,back,left,right
facing = 1
size.xscale = 0.7
size.yscale = 1
supermovetime = 999
pausemovetime = 999



;Lock Screen for Ninjutsu
[State -2, ScreenBound]
type = ScreenBound
trigger1 = numhelper(1499) = 1
value = 1
movecamera = 1,1


;-----------------------------------
;MvC Damage Damper - Currently Disabled
[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(12)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
fvar(12)=1

[State -2, Dampener]
type=varset
trigger1=1
fvar(10)= ifelse(fvar(12)=0, 1, ifelse(fvar(12)=1, 1, .9**fvar(12)))
ignorehitpause=1


;[State -2, Dampener itself]
;type=attackmulset
;trigger1= 1
;value=fvar(10)
;ignorehitpause=1

;================= AI =========================

[State -2, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "AI:%d, PosX:%f, PosY:%F"
params = var(59),P2BodyDist X, P2BodyDist Y
IgnoreHitpause = 1
supermovetime = 9999
pausemovetime = 9999


