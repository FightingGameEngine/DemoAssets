;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

;Helper to Lock Screen during Ninjutsu
[State -3, Helper]
type = Helper
triggerall = !numhelper(1499)
trigger1 = (stateno = [1405,1408]) ;|| stateno = 1435
helpertype = player
name = "Nin_Screenlock"
ID = 1499
stateno = 1499
pos = -75,0
postype = p1
keyctrl = 0
ownpal = 0

;2nd Helper to Lock Screen during Ninjutsu
[State -3, Helper]
type = Helper
triggerall = !numhelper(1498)
trigger1 = (stateno = [1405,1408]) ;|| stateno = 1435
helpertype = player
name = "Nin_Screenlock2"
ID = 1498
stateno = 1499
pos = 200,0
postype = p1
keyctrl = 0
ownpal = 0


