;Stand Light Punch
[State -1, Stand Light Punch]
type = ChangeState
value = 200
triggerall = AILevel>0
triggerall = p2statetype = A
trigger1 = p2bodydist x <=30
trigger1 = p2bodydist y = [-70,5]
trigger1 = statetype != A || (stateno = [100,105])
trigger1 = ctrl
trigger1 = random < 500

;---------------------------------------------------------------------------
;Stand Medium Punch
[State -1, Stand Medium Punch]
type = ChangeState
value = 210
triggerall = (AILevel>0) && p2statetype != C && p2statetype != L
trigger1 = stateno = 200 || stateno = 400 
trigger1 = movehit && random < 300
trigger1 = p2bodydist x <= 30

;---------------------------------------------------------------------------
;Stand Strong Punch
[State -1, Stand Strong Punch]
type = ChangeState
value = 220
triggerall = (AILevel>0) && p2statetype != C && p2statetype != L
trigger1 = stateno = 210 || stateno = 240 || stateno = 211 || stateno = 410
trigger1 = movehit
trigger1 = random < 300
trigger1 = p2bodydist x <= 40
trigger1 = p2bodydist y = [-30,5]
;---------------------------------------------------------------------------
;Stand Light Kick
[State -1, Stand Light Kick]
type = ChangeState
value = 230
triggerall = AILevel>0
triggerall = p2statetype != L && p2statetype != C
trigger1 = p2bodydist x <= 40 && (p2bodydist y = [-5,5])
trigger1 = statetype != A 
trigger1 = ctrl && p2statetype = S && random < 80
;---------------------------------------------------------------------------
;Standing Medium Kick
[State -1, Standing Medium Kick]
type = ChangeState
value = 240
triggerall = (AILevel>0)&& p2statetype != C && p2statetype != L
trigger1 = stateno = 230 || stateno = 200
trigger1 = movehit
trigger1 = random < 500
trigger2 = stateno = 400 || stateno = 430
trigger2 = movehit
trigger2 = random < 500

;---------------------------------------------------------------------------
;Standing Strong Kick
[State -1, Standing Strong Kick]
type = ChangeState
value = 250
triggerall = (AILevel>0) && p2statetype != C && p2statetype != L && p2statetype != A
