; Definition file for Blade
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Blade"        ;Name of character
displayname = "Blade" ;Name of character to display
versiondate = 06,20,2017    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Fede de 10"       ;updated by borewood2013, based on mouser's MvsC MUGEN stuff... ;Character author name
pal.defaults = 1,2,3,4,5,6      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = MMV_Blade_Marvel.cmd           ;Command set
cns     = MMV_Blade_Marvel.cns           ;Constants
st      = MMV_Blade_Marvel.cns           ;States
st1     = config.txt
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = MMV_Blade_Marvel.sff           ;Sprite
anim    = MMV_Blade_Marvel.air           ;Animation
sound   = MMV_Blade_Marvel.snd           ;Sound
ai      = MMV_Blade_Marvel.ai            ;AI hints data (not used)

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
