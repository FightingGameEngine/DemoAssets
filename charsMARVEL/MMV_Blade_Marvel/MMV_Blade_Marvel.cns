y = ifelse(!var(1),const(velocity.jump.y),-19)

[State 40, VelSet]
type = VelSet
triggerall = AILevel && Alive && P2Life != 0 && RoundState = 2 && StateType != A && MoveType != H
trigger1 = animtime = 0
x = ifelse(var(1) && p2movetype = H, const(velocity.jump.fwd.x), ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))))
