type = VarSet
;triggerall = !AILevel
trigger1 = time = 0 && var(6) < 2
var(1) = IfElse((AILevel && Alive && P2Life != 0 && RoundState = 2 && StateType != A && MoveType != H), (P2BodyDist X > 180.0 && BackEdgeDist <= 20.0), command = "highjump") || prevstateno = 420

[State 40, VarSet]
