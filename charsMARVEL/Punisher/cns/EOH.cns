;===========================================================================
;Super Marvel vs. Capcom - Eternity of Heroes - Animations Template V.8
;===========================================================================

;Var (0) = Super Jump
;Var (1) = Command input dection
;Var (2) = Super Combo (Removed)
;Var (7) = Floor Possition
;Var(8 - 10) = Announcer Text
;Var (11) = Super Jump Direction
;Var (12) = Super Jump
;Var (17) = Screen Pack
;Var (21) = Combo Mute
;Var (25) = Winko Punished
;Var (28) = Taunt
;Var (30) = Recovery Roll
;Var (59) = AI On

[Data]
life = 1000
attack = 130
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 555
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 18
air.front = 22
height = 60
attack.dist = 160
attack.width = 4,4   
proj.dist = 90
proj.attack.dist = 90 
proj.doscale = 0
head.pos = 1, -83
mid.pos = 1, -53
shadowoffset = 0
draw.offset = 0,3

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 6.6, 0    ;Run forward (x, y)
run.back = -6.5,0 ;Hop backward (x, y)
jump.neu = 0,-10.4    ;Neutral jumping velocity (x, y)
jump.back = -3.55    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .41
stand.friction = .80
crouch.friction = .80
air.friction = .80

[Quotes]
victory1 = "Consider yourself Punished!"
victory2 = "There's more where that came from!"
victory3 = "Crime doesn't pay!"
victory4 = "I'm the Punisher and you are dead!"
victory5 = "You think you're above the law, well you aint!"
victory6 = "There won't be a next time!"
victory7 = "In a one man war every hit counts!"
victory8 = "Nothing will stand in my way!"
victory9 = "This skull will be the last think you ever see!"
victory10 = "Those who prey upon the helpless will become the prey!"

