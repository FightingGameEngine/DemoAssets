[State -2, snd 1]
type = PlaySnd
trigger1 = (power >= 1000) && (power < 2000) && (var(6) < 1) && (RoundState = 2)
value = 200,0
[State -2, snd 1]
type = PlaySnd
trigger1 = (power >= 1000) && (power < 2000) && (var(6) < 1) && (RoundState = 2)
value = 200,0

[State -2, level1]
