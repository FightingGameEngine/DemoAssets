trigger1 = Var(4) = 0
trigger1 = time = 0
value = S195,3
volume = 0
channel = 5
freqmul = 1.0
loop = 0
pan = 0

[State 182, PlaySnd]
type = PlaySnd
trigger1 = Var(4) = 1
trigger1 = time = 2
value = S195,0
volume = 0
channel = 5
freqmul = 1.0
loop = 0
pan = 0

[State 182, Not Hit]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;-----------------------------------------------------------------------------
;Win Pose 3

