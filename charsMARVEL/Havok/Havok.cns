;===========================================================================
;Super Marvel vs. Capcom - Eternity of Heroes - Constants Template
;===========================================================================

;---------------------------------------------------------------------------
;Variable List
;---------------------------------------------------------------------------
;Var(1 ~ 5) = Temp Var
;Var(8)     = Combo Announcer, Text Display
;Var(9)     = Combo Announcer, Sound
;Var(10)    = Combo Announcer, Danger
;Var(11)    = Combo Announcer, Normalize Score
;Var(12)    = Super Jump
;Var(13)    = Super Jump Direction
;Var(59)    = Artificial Intelligence
;fVar(10)   = Damage Dampener
;fVar(12)   = Damage Dampener Hit Counter

[Data]
life = 1200
attack = 120
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 256
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -100
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd = 2.4
walk.back = -2.2
run.fwd = 6
run.back = -8,-3
jump.neu = 0,-9.0
jump.back = -3.7
jump.fwd = 3.2
runjump.fwd = 4.4
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5
airjump.back = -2.55
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .41
stand.friction = .80
crouch.friction = .80
air.friction = .80
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

;-----------------------------------------------------------------------------
;Win Quotes - You can have up to 100 win quotes

[Quotes]
victory1 = "You'll cry Havok, next time & run!"
victory2 = "Cosmic Power, even I can't control it"

;-----------------------------------------------------------------------------
;Run Forward

; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 1
value = S9999,99

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 6
value = S9999,1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 11
value = S9999,0

[State 0, Explod]
type = Explod
trigger1 = Animelem = 12
anim = 1003
pos = 95,12
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = 1,1
sprpriority = 6
ownpal = 0
removeongethit = 0



[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, dust]
type = Explod
trigger1 = animelem = 2
anim = 1003
pos = -40,10
supermove = 1
ontop = 1
removeongethit = 1
ownpal = 1

[State 100, dash]
type = Explod
trigger1 = animelem = 2
anim = 1301
pos = 0,0
supermove = 1
scale = 1,1.5
removeongethit = 1
ownpal = 1

[State 100, 4]
type = ChangeState
trigger1 = Animtime = 0
value = 0

;-----------------------------------------------------------------------------
;Win Poses

[Statedef 180]
type = S

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,2

[State 180, 0]
type = ChangeState
trigger1 = Var(1) = 0
value = 181

[State 180, 1]
type = ChangeState
trigger1 = Var(1) = 1
value = 182

[State 180, 1]
type = ChangeState
trigger1 = Var(1) = 2
value = 183

;-----------------------------------------------------------------------------
;Win Pose 1

[Statedef 181]
type = S
movetype = I
physics = S
ctrl = 0
anim = 181
velset = 0,0

[state 181, No Life Bar]
type = assertspecial
trigger1 = Time >= 0
flag = NoBarDisplay

[State 181, Round Not Over Yet]
type = AssertSpecial
trigger1 = time < 150
flag = RoundNotOver

[State 181, PlaySnd]
type = PlaySnd
trigger1 = time = 6
value = S180,0
volume = 0
channel = 5
freqmul = 1.0
loop = 0
pan = 0

[State 181, Not Hit]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;-----------------------------------------------------------------------------
;Win Pose 2

