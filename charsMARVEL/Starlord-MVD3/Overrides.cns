[Statedef -2]


;------------------------------------------------------

[State -2, mj]
type = Changestate
triggerall = prevstateno = 1000||prevstateno = 1200
triggerall = Var(5) >= 1
trigger1 = movetype = H
value = 1005
ctrl = 0
hitcountpersist = 1

[State -2, re]
type = removeexplod
triggerall = prevstateno = 1200 
trigger1 = movetype = H
id = 8655
hitcountpersist = 1

[State -2, ai]
type = VarSet
triggerall = (Var(59) > 0)
trigger1 = (RoundState != 2)
trigger2 = (!Alive)
var(59) = -2
hitcountpersist = 1

[State -2, a0]
type = VarAdd
trigger1 = Var(8) > 0
V = 8
value = -1
hitcountpersist = 1

[State -2, a1]
type = VarSet
trigger1 = Life > 1
trigger1 = MoveType != H
trigger1 = StateNo != 9000
var(15) = StateNo
ignorehitpause = 1
hitcountpersist = 1

[State -2, a2]
type = VarSet
trigger1 = Life > 1
trigger1 = StateNo = [120,159]
trigger1 = StateNo != 9000
var(15) = StateNo 
ignorehitpause = 1
hitcountpersist = 1

[State -2, A3]
type = VarSet
trigger1 = (Var(20) = 1) && (MoveType != H)
var(20) = 0
hitcountpersist = 1


