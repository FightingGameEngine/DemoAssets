;-----------------------------------------------------------------------------
; アーマー判定ヘルパー
;-----------------------------------------------------------------------------
[Statedef 9000]
type     = A
movetype = I
physics  = N
anim     = 9999
sprpriority = -1

[State 9000, VarSet]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State 9000, VarSet]
type = VarAdd
trigger1 = GetHitVar(damage)
var(1) = 1

[State 9000, 0/CHs]; 不具合対策
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, AssertSpecial]
type = AssertSpecial
Trigger1 = 1
flag = NoShadow
flag2 = invisible

[State 9000, 開始時だけ無敵（重複被弾防止）]
type = NotHitBy
trigger1 = time = 0
value = SCA
time = 1

[State 9000, 投げ無敵]
type = NotHitBy
trigger1 = 1
value = ,AT
time = 2

[State 9000, -1/Tra]; 透過処理
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,130

[State 9000, -1/Ass]; 影消し
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 9000, -1/Pos]; 本体に追従
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, -1/CHa]; 判定を揃える
type = ChangeAnim
trigger1 = SelfAnimExist(Parent,Anim)
value = Parent,Anim
elem = Parent,AnimElemNo(0)

[State 9000, -1/HOR]; 打撃／飛び道具を受けたらステートを繰り返す
type = HitOverRide
trigger1 = IsHelper(9000)
attr = SCA,AA,AP
stateno = 9000

[State 9000, -1/Ds]; 本体がアーマーパートを過ぎたら消滅１
type = DestroySelf
trigger1 = Parent,StateNo != 710 && Parent,StateNo != 715
trigger2 = Parent,StateNo = 715 && Parent,AnimElem = 5

