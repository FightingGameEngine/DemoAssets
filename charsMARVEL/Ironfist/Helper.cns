;-----------------------------------------------------------------------------
;スロー処理
;-----------------------------------------------------------------------------
[Statedef 4900]
type     = A
movetype = I
physics  = N
juggle   = 0
ctrl     = 0
anim     = 9999
sprpriority = 1

[State 1001,]
type = Pause
triggerall = p2life > 0
trigger1 = (GameTime%3) = 0
trigger1 = time = [0,20]
time = 1

[State 1001,]
type = Pause
triggerall = p2life > 0
trigger1 = (GameTime%6) = 0
trigger1 = time = [21,30]
time = 1

[State 4110, DestroySelf]
type = DestroySelf
trigger1 = time = 31

;-----------------------------------------------------------------------------
; カウンターヒットエフェクト
;-----------------------------------------------------------------------------
[Statedef 8800]
type    = A
movetype= I
physics = N
anim = 8800
velset = 0,0
ctrl = 0
sprpriority = 5

[State 8800, PalFX]
type = PalFX
trigger1 = time = 0
time = 1
add = 0,0,0

[State 8800, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 8800, Transparency]
type = Trans
trigger1 = 1
trans = add

[State 8800, VarSet]
type = VarSet
trigger1 = Time = 0
fvar(1) = .1375

[State 8800, VarAdd]
type = VarAdd
trigger1 = fvar(1) > 0
fvar(1) = .025

[State 8800, Scale]
type = AngleDraw
trigger1 = 1
scale = fvar(1),fvar(1)

[State 8800, PalFX]
type = PalFX
trigger1 = time = 5
time = 1
add = -50,-50,-50

[State 8800, PalFX]
type = PalFX
trigger1 = time = 6
time = 1
add = -120,-120,-120

[State 8800, PalFX]
type = PalFX
trigger1 = time = 7
time = 1
add = -190,-190,-190

[State 8800, DestroySelf]
type = DestroySelf
trigger1 = Time > 7

