[Statedef 3000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
velset   = 0,0
anim     = 3000
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 3000, VarSet]
type = VarSet
triggerall = Time = 1
trigger1 = (prevstateno = [200,299]) || (prevstateno = [400,499]) || (prevstateno = [600,699])
trigger2 = prevstateno = [1000,1999]
var(12) = 0

[State 3000, VarSet]
type = VarSet
trigger1 = Time = 1
var(15) = 0

[State 3000, 先行入力初期化]
type = varset
trigger1 = time = 0
var(31) = 0

[State 3000, 先行入力初期化]
type = varset
trigger1 = time = 0
var(32) = 0

[State 3000, NotHitBy]
type = NotHitBy
trigger1 = AnimElemtime(1) >= 0 && AnimElemtime(4) < 0
value = SCA

[State 3000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = time = 0
anim = -1
poweradd = -1000
movetime = 45
time = 45
darken = 0
p2defmul = 1.0

[State 3000, SuperPause FX]
type = Helper
trigger1 = AnimElem = 1
helperType = Normal
stateNo = 10000
ID = 10000
name = "Superpause FX"
posType = P1
pos = -10,-90
superMoveTime = 255
size.xScale = 1
size.yScale = 1
ownPal = 1

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = s9,0

[State 3000, EnvColor]
type = BGPalFX
trigger1 = time <= 45
mul = 20,175,175
time = 2
invertall = 0
ignorehitpause = 1
;color = 20

[State 3000, AfterImage]
type = AfterImage
trigger1 = Time = 0
time = 2
timegap = 1
framegap = 10
length = 30
paladd = 0,0,0
palmul = .75,.75,.75
palcontrast = 128,128,128
palpostbright = 0,0,0
trans = add1

[State 3000, AfterImageTime]
type = AfterImageTime
trigger1 = Time >= 1
time = 2

[State 1000, 軸位置移動]
