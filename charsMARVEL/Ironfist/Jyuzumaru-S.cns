[Statedef 1000]
type     = S
movetype = A
physics  = S
juggle   = 0
poweradd = 50
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 3
facep2 = 1

[State 1000, VarSet]
type = VarSet
triggerall = Time = 1
trigger1 = (prevstateno = [200,299]) || (prevstateno = [400,499]) || (prevstateno = [600,699])
var(12) = 0

[state 1000, 先行入力初期化]
type = varset
trigger1 = time = 0
var(31) = 0

[state 1000, 先行入力初期化]
type = varset
trigger1 = time = 0
var(32) = 0

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = s0,2

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = s10,3
channel = 10

[State 1000, 軸位置移動]
type = Velset
trigger1 = AnimElem = 3
x = 4

[State 1000, 軸位置移動]
type = Velset
trigger1 = AnimElem = 8
x = 0

[State 1000, ヒット定義]
type = HitDef
triggerall = var(12) = 0
trigger1 = AnimElem = 5
attr = S, SA
damage    = 36,10
getpower  = floor(36*1.2),floor(36*1.2)
givepower = 10,10
animtype = Hard
guardflag = MA
hitflag = MA
priority = 4, Hit
pausetime = 12,12+var(0)
guard.pausetime = 10,10+var(0)
sparkno = s30002
guard.sparkno = s8400
sparkxy = -10, -75
hitsound = s1,2
guardsound = s2,1
ground.type = High
ground.slidetime = 16
ground.hittime   = 19
ground.velocity  = -6
airguard.velocity = -4,-1
air.type = High
air.velocity = -4.2,-6
air.hittime = 12
yaccel = .5
air.fall = 1
fall.recover = 0
envshake.time = 12
envshake.ampl = 6; or 7
fall.envshake.time = 20
fall.envshake.ampl = 8

[State 200, スタン値削り]
type = varadd
trigger1 = movehit = 1
var(26) = 8
ignorehitpause = 1
persistent = 0

[State 200, VarSet]
type = VarSet
trigger1 = numtarget
trigger1 = movehit = 1
fvar(1) = fvar(1) * 0.8
ignorehitpause = 1
persistent = 0

[State 1000, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 6
MoveType = I

[State 1000, ステート変更]
type = ChangeState
triggerall = AnimElemtime(5) > 0 && AnimElemtime(8) < 0
trigger1 = var(59) != 1
trigger1 = command = "弱リムセ" || var(31) = 1000
trigger2 = var(59) = 1
trigger2 = moveguarded
value = 1001

[State 1000, ステート変更]
type = ChangeState
triggerall = AnimElemtime(5) > 0 && AnimElemtime(8) < 0
trigger1 = var(59) != 1
trigger1 = command = "強リムセ" || var(31) = 1010
trigger2 = var(59) = 1
trigger2 = movehit
value = 1011

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

