trigger1 = RoundState = 0
value = 191

[State 191, 1]
type = helper
trigger1 = Time = 0
stateno = 1911
pos = 22,-113
ownpal = 1
scale=1,1

[State 191, 1]
type = AssertSpecial
trigger1 = Time = [0,1000]
flag = Intro

[State 0, PlaySnd]
type = PlaySnd
trigger1 =  animelem=4
value = S191,0
volume = 0
channel = -1

[State 0, PlaySnd]
type = PlaySnd
trigger1 =  animelem=10
value = S191,2
volume = 0
channel = 0



[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

