;VARIABLES
;var(0)-var(5): Temp
;var(6);combo chain 
;var(7); enemynear, head pos y
;var(8);small opponent y dist
;var(9);miss target
;var(10);target hit
;var(11) - var(12); temp bound states
;var(13) - Combo adder
;Var(14) - number and text decider
;Var(15) - is Danger
;var(16) - normalize
;var(17)
;var(18) - escolhe anim foto
;var(19) - var(21);hit type combo
;var(22) - modo sense
;var(23) - contador
;var(24) - boolean efeito
;var(25)
;var(26)
;var(27)
;var(28) - AvX vs. Capcom Versions
;var(29) - launcher reset
;
;
;variable below 29 will reset between rounds
;
;
;var(30) - p2life /100
;var(31) - p1life /100
;var(32) - damage dampening
;var(33) - enemy(1),life/100
;var(34) - Web Swing Counter
;var(35) - Web Throw Counter
;var(36) - Web Swing Pos Set
;var(37) - Air Dash Abuse Prevention
;var(38) - Web Kick Counter
;var(39) - Ultimate Web Throw Counter
;var(40) - web refill
;var(41) - dano do estilingue
;var(42) - web refill; capsula
;var(43) - var(48); run
;var(44) - 10 bullets
;var(45) - mini contador, pra diminuir o tempo do spider sense
;var(46) - boolean contador gambiarra
;var(49) - Kyuukouka Dance
;var(50) - power dance
;var(51) - Air Hyper Recognizer
;var(52) - Web Swing Counter
;var(54) - flight mode
;var(55)
;var(56)
;var(57)
;var(58); remember ai for next round
;var(59); ai activate

;---------------------------------------------------------------------------
;Float Variables

;fvar(0) - fvar(5) ; Temp

;---------------------------------------------------------------------------


[Data]
;Amount of life to start with

life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 29
FloatPersistIndex = 19

[Size]
xscale = 1    ;Horizontal scaling factor.
yscale = 1          ;Vertical scaling factor.
ground.back = 38    ;Player width (back, ground)
ground.front = 38   ;Player width (front, ground)
air.back = 30  ;Player width (back, air)
air.front = 30  ;Player width (front, air)
height = 50          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 31,-35 ;Approximate position of head
mid.pos = 0,-25   ;Approximate position of midsection
shadowoffset = 0   ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3    ;Walk forward
walk.back = -2.7     ;Walk backward
run.fwd  = 8,-5   ;Run forward (x, y)
run.back = -8,-4.8 ;Hop backward (x, y)
jump.neu = 0,-10
jump.back =  -3.5,-10
jump.fwd = 4,-10
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1     ;.
airjump.neu = 0,-8.1     ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 3.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44        ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

[Quotes]
victory1 = "Smile pal, you're gonna be in tomorrow's Daily Bugle."
victory2 = "Good ol' spider powers. What would I do without you?"

