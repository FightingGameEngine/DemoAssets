[Data] 
;Amount of life to start with
life = 1300
attack = 125
defence = 130
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
power = 3000
guard.sparkno = 40
KO.echo = 0
volume = 50
IntPersistIndex = 1
FloatPersistIndex = 1

[Size]
xscale = 1.1      ;Horizontal scaling factor.
yscale = 1          ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 28    ;Player width (front, ground)
air.back = 20        ;Player width (back, air)
air.front = 25       ;Player width (front, air)
height = 50         ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -120   ;Approximate position of head
mid.pos = -5, -80    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.0      ;Walk forward
walk.back = -2.0     ;Walk backward
run.fwd  = 6.5, -2.5   ;Run forward (x, y)
run.back = -5.6,-3.8 ;Hop backward (x, y)
jump.neu = 0,-10  ;Neutral jumping velocity (x, y)
jump.fwd = 3.0       ;Jump forward Speed (x, y)
jump.back = -3.0    ;Jump back Speed (x, y)
runjump.back = -2.55,-9.6 ;Running jump speeds (opt)
runjump.fwd = 3,-9.6      ;.
airjump.neu = 0,-9.8      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 15  ;Minimum distance from ground before you can air jump (opt)
yaccel = .42   ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching



[Quotes]
victory1= "You're not dressed warmly enough"
victory2= "Did you think that you could decieve me?"
victory3= "Never has an enemy slipped my watch"
victory4= "Be warned, i will honor my sworn oath to protect this realm, as it's gatekeeper"
victory5= "If your return treatens the safety of Asgard, Bifrost will remain closed, and you'll be left to die in the cold waste"
victory6= "To leave the bridge open, would unleash the full power of the Bifrost and destroy Jotenheim, with you upon it"
victory7= "None ever have plans to die"
victory8= "You're late, you must be doing it incorrectly"
victory9= "The stars are still shinning, from here I can see nine realms, and ten trillion souls"
victory10= "The universe has not seen this marvel since my watch began"
victory11= "Few can sense it, even fewer can see it"
victory12= "And while it's effects can be dangerous, it is truely beautiful"
victory13= "Welcome to Asgard!"
victory14= "There is always hope"
victory15= "Odin is my king, and I am sworn to obey him, but I need no longer obey you!"
victory16= "Never have I witnessed so mighty a mortal!"
victory17= "Perhaps someone has found a way to hide that which he does not wish me to see"
victory18= "I am bound by honor to our king. I cannot open the bridge to you"
victory19= "There are paths between the realms known only to a few"
victory20= "The son of Odin, you must wake up! You must save us, can't you see we are all dead"
victory21= "You wish to know what I see? I see Trolls still hiding on Midgard, the same Trolls who reduce towns to smoke & rubble"
victory22= "You wish to know what I see? I see a Serpent let loose in Heaven"
victory23= "You wish to know what I see? A brother in turmoil. A sister in peril"
victory24= "You wish to know what I see? Strife between a mother and father that may consume us all"
victory25= "You wish to know what I see? I see bonfires as rises a queen of fire.  I see a king who waits in Hel to be reborn"
victory26= "You wish to know what I see? I see wars, More wars than we can possibly endure"
victory27= "Thou shall not pass, even within Ragnarok"
victory28= "BY THE BRISTLING BEARD OF ODIN!! Thou dost not fall! What manner of being art thou??!"
victory29= "I, who can see a hummingbird's wing, though he be a universe away"
victory30= "I, who can hear the rustling of a leaf within some distant galaxy"
victory31= "The Bifrost is closed, No one is to come or to go. We face an enemy that is invisible even to me"
victory32= "I Cannot overrule my kings wishes, not even for you"
victory33= "My eyes? Oh, they see everything... They see you leading us to Hel!"
victory34= "It is my sworn duty to notify Odin, of crimes against the throne"
