; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Carnage"        ;Name of character
displayname = "Carnage" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "JC"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = carnage.cmd   ;Command set
cns     = carnage.cns   ;Constants
st      = carnage.cns   ;States
stcommon = common1.cns ;Common states
sprite  = venom.sff   ;Sprite
anim    = venom.air  ;Animation
sound   = venom.snd   ;Sound
pal1   = carnage.act
pal2    = venom4.act
pal3    = clowncarnage.act
pal4   = carnageorange.act
pal5    = green.act
pal6    = greyblue.act


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def