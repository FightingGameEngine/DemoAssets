;---------------------------------------------------------------------------
;-------------------------------[ states ]----------------------------------
;---------------------------------------------------------------------------
; lose by time over
[statedef 170]
type = s
ctrl = 0
anim = 170
velset = 0,0

[State 170,0]
type = PlaySnd
trigger1 = Time = 0
value = 170,0
channel = 5
volume = 255

[state 170, 1]
type = nothitby
trigger1 = 1
value = sca
time = 1
;---------------------------------------------------------------------------
; lose by Draw
[statedef 175]
type = s
ctrl = 0
anim = 175
velset = 0,0

[State 175,0]
type = PlaySnd
trigger1 = Time = 0
value = 175,0
channel = 5
volume = 255

[state 175, 1]
type = nothitby
trigger1 = 1
value = sca
time = 1
;---------------------------------------------------------------------------
; win state Decider
[statedef 180]
type = s
ctrl = 0
velset = 0,0

[state 180, 3]
type = changestate
trigger1 = var(11) = 1 && matchover = 1
value = 183

[state 180, winpose Decider]
type = changestate
trigger1 = time = 0
value = 181 + ((random * 3) / 1000)     ; change the 1 to however many winposes you have

;---------------------------------------------------------------------------
; win pose 1
[statedef 181]
type = s
ctrl = 0
anim = 181
velset = 0,0

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 5
range = 0,2

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 0
trigger1 = animelem = 5
value = S180,0
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 1
trigger1 = animelem = 5
value = S180,1
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 2
trigger1 = time = 1
value = S180,2
volume = 255
channel = 5

[State 181,1]
type = AssertSpecial
trigger1 = Time = [0,250]
flag = RoundNotOver

;---------------------------------------------------------------------------
; win pose 2
[statedef 182]
type = s
ctrl = 0
anim = 182
velset = 0,0

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 5
range = 0,1

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 0
trigger1 = time = 1
value = S180,3
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 1
trigger1 = time = 6
value = S180,4
volume = 255
channel = 5

[State 182,1]
type = AssertSpecial
trigger1 = Time = [0,180]
flag = RoundNotOver

;---------------------------------------------------------------------------
; win pose 3
[statedef 183]
type = s
movetype = a
physics = n
anim = 1830

[state 183, 1]
type = velset
trigger1 = time = 0
x = const(velocity.walk.fwd.x)

[state 183, 2]
type = velset
trigger1 = abs(screenpos x - enemynear,screenpos x) < 73
x = 0

[state 183, 3]
type = posadd
trigger1 = anim = 183 && animelem = 1
x = 73 - ( enemynear,screenpos x - screenpos x)

[State 3300, PlaySnd]
type = PlaySnd
triggerall = anim = 183
trigger1 = animelem = 5
value = S3300,9
channel = 5
volume =255

[State 3300, PlaySnd]
type = PlaySnd
triggerall = anim = 183
trigger1 = animelem = 6
value = S3300,3
channel = 4
volume =255

[State 3300, Explod Phoenix]
type = Explod
triggerall = anim = 183
trigger1 = animelem = 6
anim = 3301
ID = 3301
pos = -30,-50
postype = p1
removetime = -2
pausemovetime = 9999
supermovetime = 9999
scale = 2,2
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 1

[State 3300, Explod Wings]
type = Explod
triggerall = anim = 183
trigger1 = animelem = 6
anim = 3302
ID = 3302
pos = 0,-100
postype = p1
removetime = 250
scale = 1,1
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 1

[state 183, 4]
type = changeanim
trigger1 = vel x = 0 && anim != 183
value = 183

[State 183,5]
type = AssertSpecial
trigger1 = Time = [0,290]
flag = RoundNotOver

;---------------------------------------------------------------------------
; win pose vs cyclops
[statedef 184]
type = s
movetype = a
physics = n
anim = 1830

[state 184, 1]
type = velset
trigger1 = time = 0
x = const(velocity.walk.fwd.x)

[state 184, 2]
type = velset
trigger1 = abs(screenpos x - enemynear,screenpos x) < 73
x = 0

[state 184, 3]
type = posadd
trigger1 = anim = 183 && animelem = 1
x = 73 - ( enemynear,screenpos x - screenpos x)

[state 184, 4]
type = changeanim
trigger1 = vel x = 0 && anim != 183
value = 183

;---------------------------------------------------------------------------
; Introduction
[statedef 190]
type = s
ctrl = 0
velset = 0,0

[state 190, intro]
type = assertspecial
trigger1 = 1
flag = intro

[state 190, 1]
type = changestate
trigger1 = time = 1 && p2name = "cyclops"
trigger2 = time = 1 && p2name = "[vanessa]'s cyclops"
value = 193

[state 190,intro Decider]
type = changestate
trigger1 = time = 1
value = 191 + ((random * 2) / 1000); change the 1 to however many intros you have

