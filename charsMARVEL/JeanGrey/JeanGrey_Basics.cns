;---------------------------------------------------------------------------
; Description: throws are not Difficult to make, although then can be
;     tedious at times. throw attempt states have a hitdef of a
;     special Format. the key parameters in a throw are p1stateno
;     and p2stateno. if the hitdef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. the special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state File. in this case, no matter who the
;     opponent is, he will be taken to state 820 of this File (kfm.cns)
;     and remain here Until the end of the throw (look at his Debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state File).
;---------------------------------------------------------------------------
 ;Throw
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State 800, PlaySnd]
type = PlaySnd
trigger1 =  AnimElem = 2
value = 999,5

[State 800, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NT
hitflag = M-
priority = 1, Miss
sparkno = -1
sprpriority = 2
;p1facing = ifelse(command="holdfwd",1,-1)
p1stateno = 810
p2stateno = 820
guard.dist = 0
fall.xvelocity = 0
fall.yvelocity = 0
fall = 0
fall.recover = 0
fall.damage = 80

[State 800, ChangeState]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
sprpriority = 2

[State 810, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 810, TargetBind]
type = TargetBind
trigger1 = time = 0
time = 1
id = -1
pos = 30,-30

[State 810, TargetLifeAdd]
type = TargetLifeAdd
trigger1 = AnimElem = 2
value = -7

[State 810, TargetState]
type = TargetState
trigger1 = time = 40
value = 830

[State 810, ChangeState]
type = ChangeState
trigger1 = time = 40
value = 811
ctrl = 0

[Statedef 811]
type    = S
movetype= I
physics = S
velset = 0,0
anim = 811
sprpriority = 0

[State 811, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 811, PlaySnd]
type = PlaySnd
trigger1 = animelemtime(4)=0
value = S999,4

[State 811, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,-1.1
sprpriority = 0

[State 820, ChangeAnim2]
type = ChangeAnim2
trigger1 = Time = 0
value = 820

[State 820, PosAdd]
type = PosAdd
trigger1 =  time = 0
y = -50

[State 820, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[Statedef 830]
type    = A
movetype= H
physics = N
velset = 17,-3
poweradd = 50

[State 830, ChangeAnim2]
type = ChangeAnim2
trigger1 = (Time = 0)
value = 830

[State 830, PosAdd]
type = PosAdd
trigger1 = Time = 0
Y = 45

[State 830, VelAdd]
type = VelAdd
trigger1 = Time >= 1
Y = 0.5

[State 830, SelfState]
type = SelfState
trigger1 = (Pos Y >= 0) && (Vel Y > 0)
value = 5100
ctrl = 0


;---------------------------------------------------------------------------
; override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; states that are always executed (use statedef -2)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; states that are executed when in self's state File (use statedef -3)
;---------------------------------------------------------------------------

[statedef -2]

;Hover
[State -2, VelAdd]
type = VelAdd
triggerall = statetype = A
triggerall = vel y > 2
triggerall = movetype != A
triggerall = movetype != H
triggerall = ctrl
trigger1= command = "holdup"
y = -0.65


;this controller plays a sound everytime the player lands From a jump, or
;from a back-dash.

;---------------------------------------------------------------------------
[state -2, landing sound]
type = playsnd
triggerall = time = 1
trigger1 = stateno = 52 ;jump land
trigger2 = stateno = 106 ;run-back land
value = 40, 0

;---------------------------------------------------------------------------
[State -2, Super MvC BG K.O.]
type = Helper
trigger1 = winko && (stateno = [3000,3502])
triggerall = NumHelper(6000) < 1
helpertype = normal ;player
name = "winko"
ID = 6000
stateno = 6000
pos = 0,0
postype = left   ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermove = 999
pausemove = 999
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;-[ super armor ] - telekinetic shield

[state 0, varadd]
type = varadd
trigger1 = var(37)> 0
trigger1 = 1
v = 37
value = -1

[state 0, nothitby]
type = nothitby
trigger1 = numhelper(3001)>0
value = sca,na,sa,ha,np,sp,hp,nt,st,ht
time = 1

[state -2]
type = varset
trigger1 = time = 520
trigger1 = movetype != h
trigger1 = stateno != 9000
var(46) = stateno
ignorehitpause = 1

[state -2]
type = varset
trigger1 = time = 520
trigger1 = stateno = [120,159]
trigger1 = stateno != 9000
var(46) = stateno
ignorehitpause = 1

;-----------------------------------------------------------------------------
; wall hit
[state -2, explod]
type = explod
triggerall = time = 1
triggerall = enemynear,stateno!= [120,155]
trigger1 = enemynear,movetype = h
trigger1 = enemynear,backedgedist<15
trigger1 = enemynear,statetype = a
trigger2 = enemy,movetype = h
trigger2 = enemy,Frontedgebodydist<25
trigger2 = enemy,stateno = 5220
anim = 7020
pos = 0,0
postype = p2
sprpriority = -3
bindtime = 1
facing = -1
scale = 0.6,0.52
removetime = -2
id = 7020
ownpal = 1

[state -2, playsnd]
type = playsnd
triggerall = time = 1
triggerall = enemynear,stateno!= [120,155]
trigger1 = enemynear,movetype = h
trigger1 = enemynear,backedgedist<15
trigger1 = enemynear,statetype = a
trigger2 = enemy,movetype = h
trigger2 = enemy,Frontedgebodydist<25
trigger2 = enemy,stateno = 5220
value = s5000,3
volume = 255
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
[statedef -3]

;---------------------------------------------------------------------------
; Dizzy System

[State -3, 1]
type = VarAdd
triggerall = Time = 0
trigger1 = (StateNo = 5000) || (StateNo = 5010) || (StateNo = 5020) || (StateNo = 5070) || (StateNo = 5080)
v = 23
value = 1
ignorehitpause = 1

[State -3, 2]
type = VarSet
trigger1 = MoveType != H
v = 23
value = 0
ignorehitpause = 1

[State -3, 3]
type = VarAdd
triggerall = (Time = 0) && (Var(23) < 15) && (Var(24) = 0)
trigger1 = (StateNo = 5000) || (StateNo = 5010) || (StateNo = 5020) || (StateNo = 5070) || (StateNo = 5080)
v = 22
value = ((GetHitVar(animtype)=0)*100)+((GetHitVar(animtype)=1)*200)+((GetHitVar(animtype)=2)*300)+((GetHitVar(animtype)>=3)*400)

[State -3, 4]
type = VarAdd
trigger1 = Var(22) > 0
v = 22
value = ifelse(MoveType = A,-3,-2)

[State -3, 5]
type = VarSet
trigger1 = Var(22) < 0
v = 22
value = 0
ignorehitpause = 1

[State -3, 6]
type = VarSet
trigger1 = (MoveType != H) && (StateNo != [980,990])
v = 24
value = 0

[State -3, 7]
type = ChangeState
triggerall = Time = 1
trigger1 = (StateNo = 5000) || (StateNo = 5010) || (StateNo = 5020) || (StateNo = 5070) || (StateNo = 5080)
trigger1 = (Var(22) >= 8000) && (LoseKO = 0)
value = 980
ignorehitpause = 1
persistent = 0
