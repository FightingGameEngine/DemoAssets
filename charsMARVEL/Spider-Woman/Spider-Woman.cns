type = ChangeState
value = 6010
trigger1= command = "x"

[State 5000, medium punch]
type = ChangeState
value = 6011
trigger1 = command = "y"

[State 5000, strong punch]
type = ChangeState
value = 6012
trigger1 = command = "z"

[State 5000, weak kick]
