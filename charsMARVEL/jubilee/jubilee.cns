y = 0
x = 0

[State 0, PosSet]
type = PosSet
trigger1 = !time
y = 0
;ignorehitpause = 
;persistent = 


[state 11, 1] ;
type = changeanim
trigger1 = anim = 6 && animtime = 0
value = 11

