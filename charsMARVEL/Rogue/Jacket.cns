trigger1 = time = 0
time = 1


[State 28000, VelSet] ;jacket falls
type = VelSet
trigger1 = backedgedist > 15
x = -7
y = 5

[State 0, VelSet] ;jacket hits wall while falling
type = VelSet
trigger1 = backedgedist <= 15
trigger1 = Pos Y < 0
x = 0

[State 28000, VelSet] ;jackets hits ground
type = VelSet
trigger1 = Pos Y >= 0
x = 0
y = 0

[State 0, PosSet] ;if jecket gets stuck in the air
type = PosSet
trigger1 = vel x = 0
trigger1 = vel y = 0
