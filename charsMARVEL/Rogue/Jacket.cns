;-------------------------------------
; Jacket Helper State
;-------------------------------------

[Statedef 20000]
type    = S
movetype = I
physics = N
sprpriority = 2
anim = 20000000
ctrl = 0

[State 20000, ChangeState]
type = ChangeState
trigger1 = (parent,var(23)= 1)
trigger1 = parent, ctrl = 0
value = 28000

[State 20000, BindToParent];Normal Bind
type = BindToParent
trigger1 = 1
facing = 1
pos = 0,0
time = ifelse (parent, Var(23) = 0, -1, 0)

[State 20000, BindToParent];While walking/dashing into opponent
type = BindToParent
triggerall = (parent, vel x > 0) && (parent, p2bodydist x <= 5)
trigger1 = parent, stateno = [100,110]
trigger2 = parent, stateno = 20
facing = 1
pos = -3,0
time = ifelse (parent, Var(23) = 0, -1, 0)

[State 20000, BindToParent];While opponent walking into Rogue
type = BindToParent
triggerall = (parent, stateno = 0) && (parent, backedgedist > 0)
trigger1 = (p2stateno = 20) && (parent, p2bodydist x <= 0)
facing = 1
pos = -1.5,0
time = ifelse (parent, Var(23) = 0, -1, 0)

[State 20000, BindToParent];While opponent dashing into Rogue
type = BindToParent
triggerall = (parent, stateno = 0) && (parent, backedgedist > 0)
trigger1 = (p2stateno = [100,110]) && (parent, p2bodydist x <= 0)
facing = 1
pos = -4,0
time = ifelse (parent, Var(23) = 0, -1, 0)

