;hitspark = 0-2,3
;wall hit = 7024
;launch = 7025 (HK) (C,HP)
;hyper background = 15600
;guard push = 7020
;recovery roll = checked
;normal throw = checked (F, HP) air
;5300, 5500

;VARIABLES
;var(0-4): Temp
;var(5) random stolen booster
;var(6) combo chain
;var(7) enemynear, head pos y
;var(8) small opponent y dist
;var(9) miss target
;var(10) target hit
;var(11-12) temp bound states
;-------
;var(13) Combo adder 
;Var(14) number and text decider 
;Var(15) is Danger
;var(16) normalize 
;----------
;var(17) 
;var(18) Rapid Punch Counter
;var(19) 
;var(20)
;var(21)
;var(22) Drop jacket
;var(23) Drop jacket
;var(24) OTG Counter (def 1540)
;var(25-27) hitcount
;var(28) Stolen Power Counter
;var(29) 
;
;variable below 29 will reset between rounds except
;
;var(30) p2life /100
;var(31) p1life /100
;var(32) damage dampening
;var(33) enemy(1),life/100
;var(34)
;var(35)
;var(36)
;var(37) Taunt
;var(38) OTG Counter (def 721)
;var(39) ***Speed Booster***
;var(40) Stolen Powers
;var(41) Megaman Buster Charging
;var(42) ***Life Booster***
;var(43-48) run
;var(49) ***Defense Booster***
;var(50) ***Power Booster***
;var(51) 
;var(52) damage to super armor
;var(54) flight mode
;var(55) Super Armor
;var(56) Stolen Power Counter/Limiter
;var(57) Kishin Riki
;var(58) remember ai for next round
;var(59) ai activate

;---------------------------------------------------------------------------
;Float Variables

;fvar(0); Temp
;fvar(1); Temp
;fvar(2); P2 mid.pos x
;fvar(3); P2 mid.pos y

;---------------------------------------------------------------------------


[Data]
;Amount of life to start with

life = 1000
;attack power (more is stronger)

attack = 100
;defensive power (more is stronger)

defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 50
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2;7200
;Default guard spark number
guard.sparkno = 40;7300
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 255 
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 29
FloatPersistIndex = 19

[Size]
xscale = 1    ;Horizontal scaling factor.
yscale = 1          ;Vertical scaling factor.
ground.back = 20    ;Player width (back, ground)
ground.front = 20   ;Player width (front, ground)
air.back = 20  ;Player width (back, air)
air.front = 20  ;Player width (front, air)
height = 50          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 2,-81 ;Approximate position of head
mid.pos = -1,-51   ;Approximate position of midsection
shadowoffset = 0   ;Number of pixels to vertically offset the shadow
draw.offset = 0,-5    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3    ;Walk forward
walk.back = -2.7     ;Walk backward
run.fwd  = 8,-5   ;Run forward (x, y)
run.back = -8,-4.8 ;Hop backward (x, y)
jump.neu = 0,-10
jump.back =  -3.5,-10
jump.fwd = 4,-10
runjump.fwd = 5,-9
runjump.back = -3.5,-10
airjump.neu = 0,-8.3	;.
airjump.back = -2.9	;Air jump speeds (opt)
airjump.fwd = 2.9   ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 40
yaccel = .5
stand.friction = .80
crouch.friction = .83;Friction coefficient when crouching

[Quotes]
victory1 = "Ya'll need to learn how to behave."
victory2 = "You're power is my power."

;[ja.Quotes]
;victory1 = ""


