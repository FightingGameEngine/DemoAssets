trigger1 = command = "holdfwd"
x = 1.7

[State 1210, stop moving]
type = VelSet
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
x = 0

[State 1210, VelSet]
type = VelSet
trigger1 = command = "holdup"
trigger1 = Pos Y > -180
y = -1.7

[State 1210, VelSet]
type = VelSet
trigger1 = command = "holddown"
y = 1.7

[State 1210, stop moving]
type = VelSet
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger2 = Pos Y >= 0
trigger3 = Pos Y < -180
y = 0

[State 1210, PosSet]
type = PosSet
trigger1 = Pos Y < -180
y = -180

[State 1210, 1] ;Turn if not facing opponent
