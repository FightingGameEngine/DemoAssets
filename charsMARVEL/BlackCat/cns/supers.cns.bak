trigger1 = p2dist X < -5

[State 1210, ChangeAnim]
type = ChangeAnim
triggerall = Anim = [1201,1209]
trigger1 = Vel X != 0
trigger2 = Vel Y != 0
value = 1210
elem = anim-1200

[State 1210, ChangeAnim]
type = ChangeAnim
triggerall = Anim = 1210
trigger1 = Vel X = 0
trigger1 = Vel Y = 0
value = 1200 + AnimElemNo(0)

[State 1210, StateTypeSet]
type = StateTypeSet
trigger1 = Pos Y >= -1
statetype = A
movetype = I
physics = A

[State 1210, Oops]
type = ChangeState
trigger1 = fvar(11) != [-200,200]
trigger2 = RoundState >2
value = 1211

[State 1210, Attcks]
