; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 0,0]
type = PlaySnd
trigger1 = animelem = 2
value = 4,2
volume = 255

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = !time
value = 181 + random%5
;---------------------------------------------------------------------------
; Win pose 1 - Bow
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 0,0]
type = AssertSpecial
trigger1 = time <= 210
flag = roundnotover

[State 0,0]
type = PlaySnd
trigger1 = Time = 1
value = 181,0
volume = 255

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;--| Falas | --------------------------------------------------------------

[State 0, tirar barras e tal]
type = AssertSpecial
trigger1 = Matchover = 1 && time = [200,400]
flag = Invisible
flag2 = roundnotover
flag3 = NoBarDisplay

[State 0, tirar barras e tal]
type = AssertSpecial
trigger1 = Matchover = 1 && time > 200
flag = globalnoshadow
flag2 = NoMusic
flag3 = NoFG

[State 0, ]
type = StopSnd
