; Intros
[Statedef 190]  ; intro selector
type = S
ctrl = 0
VelSet = 0,0

[State 190, ChangeState]
type = ChangeState
trigger1 = P2Name = "Spider-man" || P2Name = "Spiderman"
value = 19600;ifelse(random<=500,19600,193)
ctrl = 0

[State 190,intro decider]
type = ChangeState
trigger1 = time = 0
trigger1 = P2Name != "Spider-man" || P2Name != "Spiderman"
value = ifelse(random>500,19600,191 + random%2); by Ilu. Mude o 2 se quiser mais intros



