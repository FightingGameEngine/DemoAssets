[Info]
name = "Apocalypse Now! (XMvSF)"

[Camera]
startx = 0
starty = 0
boundleft = -222	; Should be 224
boundright = 222	; Should be 224
boundhigh = -250
boundlow = 0
verticalfollow = 1
floortension = 70
tension = 60

[PlayerInfo]
p1startx = -70
p1starty = 0
p1startz = 27		; Stage identifier
p1facing = 1
p2startx = 70
p2starty = 0
p2startz = -27		; Stage identifier
p2facing = -1
leftbound  = -1000
rightbound =  1000
topbound  =  0
botbound  =  0

[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 210
autoturn = 1
resetBG = 0

[Shadow]
yscale = 0.2
reflect = 0

[Music]
;bgmusic = 1.da
bgmusic = sound/apoc.mp3
bgvolume = 255

[BGdef]
spr = stages/xmvsf_apocalypse_now.sff
debugbg = 0

[bg space1]
type  = anim
actionno = 1
delta = .9, .8
;delta = .6, .6

[bg stage]
type  = anim
actionno = 2
delta = .9, .8

[bg space2]
type  = anim
actionno = 9
delta = .9, .8

[bg danpsy]
type  = normal
spriteno = 4, 0
mask  = 1

[bg dancry]
type  = anim
actionno = 3

[bg danscratch]
type  = anim
actionno = 4

[bg psyhead]
