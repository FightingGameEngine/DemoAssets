[Scene 4]
; Fade
fadein.time = 15
fadein.col = 255,255,255
fadeout.time = 15
fadeout.col = 0,0,0
; Screen color
; The previous clearcolor value is carried over by default
; Overlay Anims (from 0 to 9)
; The previous layerall.pos value is carried over by default
layer0.anim = 40
layer0.offset = 0,0
layer0.starttime = 0
layer1.anim = 41
layer1.offset = 0,0
layer1.starttime = 0
; Total time
end.time = 400

