; Variables - May or may not list all variables used
;---------------------------------------------------
; Var(0) = AI - On/Off
; Var(1) = AI - used by the XOR-ed commands method to detect recent custom states.
; Var(2) = AI - the GameTime variable, required by the helper and XOR methods.
; Var(3) = AI - Randomize moves
; Var(4) = Unused - AI bits - 1 = Opponent has Super Armor
; Var(5) = StateNo - For Super Armor
; Var(6) = 
; Var(7) = GetHit Take Counter - Determines when the Hurt Anim takes place
; Var(8) = Randomizer - Used for Sparkle Pos X
; Var(9) = Randomizer 2 - Used for Sparkle Pos Y
; Var(10) = 
; Var(11) = Onslaught - Glow Counter - To save glow time because of Super Armor
;		  = Sentinel - Stand Smoke Counter
; Var(12) = Float Counter - To save float time because of Super Armor. Used in Forms 1 and 2
; Var(13) = State NumContact Counter - Since there is no NumContact, this will be used to keep track of hits and guarded hits in states. Used in Hyper Rush state (11401)
; Var(14) = Onslaught (2nd Form) - Hit PalFx Counter
;		  =	Sentinel - Hit PalFx Counter
; Var(15) = Unused - NumGetHit Counter - Used to increase defense
; Var(16) = Unused - GetHitTime - Used to reset NumGetHit to 0 when it reaches 0
; Var(17) = Unused - Global NumContact Counter - Keeps track of hits and guarded hits globally
; Var(18) = Partner Change - Timer
; Var(20) = Onslaught (2nd Form) - Move Toggler - Used only for Rensha Beam
; Var(21) = Life
; Var(22) = Self-state Check. Since state -3 is not run through in opponent's state. Having it reset in state -3 and set to 1 in state -2 can check if the player is in the opponent's state when it is 1.
; Var(23) = Forced Turn Check. Used to keep track of Facing in state -3.
; Var(24) = Forced ChangeAnim Check. Used to keep track of Anim in state -3.
; Var(25) = Forced ChangeAnim Elem Check. Used to keep track of AnimElemNo(0) in state -3.
; Var(28) = Onslaught - GetHit Threshold - Anti-Spam - increases each time hurt anim takes place. Lowers when not in hurt anim
; Var(29) = Sentinel's Life Red
; Var(30) = Sentinel's Life
; Var(31) = Temp State Timer - Used to keep count of time for states due to super armor
;			Used for States 100 (Run Fwd) and 105 (Run Back)
; Var(32) = Super Jump - Detects if Super Jump was performed to add correct Vel Y
; Var(33) = Sentinel - Fly Switch
; Var(34) = Sentinel - Fly timer
; Var(35) = Sentinel - Plasma Storm - Charge timer
; Var(36) = Sentinel - Plasma Storm - Extra energy ball limit
; Var(37) = Sentinel - Plasma Storm - Extra energy ball command time limit
; Var(38) = Sentinel - Plasma Storm - Charge level counter
; Var(39) = Sentinel - KO Snd - Play once
; Var(40) = Sentinel - Grab Switch
; Var(41) = Sentinel - Grab Timer
; Var(42) = Sentinel - Win Pose Decider
; Var(43) = Sentinel - Dizzy Counter
; Var(44) = Sentinel - Fly Direction - Used for ease of implementing AI
; Var(45) = 
; Var(47) = Announcer Hits
; Var(48) = Announcer Text
; Var(49) = Announcer Danger
; Var(50) = Character: 0 = Onslaught (1st Form), 1 = Onslaught (2nd Form), 2 = Xavier, 3 = Sentinel
; Var(51) = Rounds Lost to change Var(50). Rounds Won - Onslaught (2nd Form)
; Var(52) = Unused - Stage Interaction: Fight Time; Var(52) = 3 = Trigger Floor
; Var(53) = Sentinel - Enable as P1 Simplifier
; Var(54) = P2 Life
; Var(57) = AI - the primary AI variable
; Var(58) = Training Mode Detection - Previous Power
; Var(59) = Training Mode Detection
; 
;
; Float Variables
;-----------------
; FVar(0) = Pos Y - Used for floating and correcting transition from Intro to Round Start position
; FVar(1) = Pos X/Forced Pos X Check - Used to store Pos X so shaking will stay put. It is not set in state 15001 because if Onslaught is hit in that state, then the Pos X will be set to what his Pos X was in 15001 not the previous state's Pos X
; FVar(2) = Pos Y - Before entering state. Used for floating for Onslaught (2nd Form)
; FVar(3) = Forced Pos Y Check - If Pos Y != FVar(3) = custom state
; FVar(10) = Attack Damage Dampener - 10% less damage with each consecutive hit
; FVar(11) = Defense Damage Dampener - Used to reduce damage when enemy has more life
; FVar(12) = Dash Punch - BackEdgeDist Check - used as a failsafe if BackEdgeDist is not met
; FVar(20) = Sentinel - Win B - P2 Pos X
; FVar(21) = Sentinel - Win B - TargetState - Successful
; FVar(25) = Sentinel - Standing Medium Kick - Cornerpush
; FVar(29) = BGMusic - Played
; FVar(30) = Config - BGMusic
; FVar(31) = Config - Resurrection
; FVar(32) = Config - TimerFreeze
; FVar(36) = Config - P2 Life Recovery Percentage - after resurrection

