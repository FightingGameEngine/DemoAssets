;Density Hyper
[State -2, DefenceMulSet]
type = DefenceMulSet
trigger1 = var(17) = 3
value = 0.01

;Density
[State -2, DefenceMulSet]
type = DefenceMulSet
trigger1 = var(17) = 0
value = 1

[State -2, PalFX]
type = PalFX
trigger1 = var(17) = 3
time = 650
add = 750, 135, 0
mul = 255 ,240,100
sinadd = 15,35,55,85
trans = 1
ignorehitpause = 1

;Density
[State -2, VarSet]
type = VarSet
trigger1 = var(17)!= 0 && numexplod(3101) = 0
v = 17
value = 0

;=========AvX Damage Multiplier===========

[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(12)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
trigger3 = hitdefattr = SCA, HA,HP,HT
trigger4 = stateno = [3000,3999]
fvar(12)=0

[State -2, Multiplier]
type=varset
trigger1=1
fvar(10)= ifelse(fvar(12)<9,ifelse(fvar(12)=0, 1, ifelse(fvar(12)=1, 1.05, 1.05**fvar(12))),1.5)
ignorehitpause=1

[State -2, Multiplier itself]
type=attackmulset
trigger1= 1
value= fvar(10)
ignorehitpause=1
ignorehitpause=1

