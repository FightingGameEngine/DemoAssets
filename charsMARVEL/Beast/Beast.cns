;Project X Run
; RUN_FWD
[Statedef 101]
type    = S
movetype = I
physics = N
anim = 101
sprpriority = 1
velset = 7.5, 0

[State 100, PlaySnd]
type = PlaySnd
trigger1 = animelem = 4
value = S8100,1

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = Pos Y >= 0
triggerall = !Var(59)
trigger1 = command != "holdfwd";Time = 135
value = 0
ctrl = 1

[State 100, 4]
type = ChangeState
triggerall = Pos Y >= 0
triggerall = Var(59)
trigger1 = time > 15
value = 0
ctrl = 1


