;var(21) = Attack Multiplier
;var(22) = Mine Counter
;var(28) = Taunt Timer
;var(30) = Recovery Roll
;var(31) = Air Roll Counter
;var(40) = Feral Lunge Counter
;var(50) = Move Before Match

