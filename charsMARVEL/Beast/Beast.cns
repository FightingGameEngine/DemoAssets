value = 1705 ;upwards

[State 0, ChangeState]
type = ChangeState
trigger1 = (command = "holddown")
value = 1703 ;downward

;-----------
;Decider
[State 0, ChangeState1]
type = ChangeState
trigger1 = ((enemynear, pos y) - pos y = [-40,40]) ;&& p2bodydist x > 60
value = 1704 ;right across

[State 0, ChangeState2]
type = ChangeState
trigger1 = p2bodydist x > 60 && (enemynear, pos y) >= (pos y)
value = 1700 ;down right

[State 0, ChangeState3]
type = ChangeState
trigger1 = p2bodydist x > 60 && ((enemynear, pos y) < pos y)
value = 1701 ;up right

[State 0, ChangeStatex]
type = ChangeState
trigger1 = (p2bodydist x = [-60,60]) && (enemynear, pos y) > (pos y)
value = 1703 ;downward

[State 0, ChangeState]
type = ChangeState
trigger1 = 1
value = 1705 ;upwards

;------------------
;Bombardment (Ground decider)
[Statedef 1752]

[State 0, VarSet]
type = VarAdd
trigger1 = time = 0
v = 3
value = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = var(3) = 9
value = 1754

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 0, VarSet]
type = VarAdd
trigger1 = time = 0 && var(1) != 0
v = 2
value = 1

[State 0, VarSet]
type = VarSet
trigger1 = time = 0 && var(1) != 0
v = 1
value = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = var(2) >= 5
trigger2 = var(3) = 9
value = 1754

[State 0, ChangeState]
type = ChangeState
trigger1 = (command = "holdup") && (command = "holdback")
trigger2 = (command = "holdup") && (command = "holdfwd")
value = 1706 ;left up

[State 0, ChangeState]
type = ChangeState
trigger1 = (command = "holdup") && (command = "holdfwd")
value = 1701 ;up right

[State 0, ChangeState]
type = ChangeState
trigger1 = (command = "holdfwd")
value = 1704 ;right across

[State 0, ChangeState]
type = ChangeState
trigger1 = (command != "holdup") && (command = "holdback")
value = 1702 ;left across

[State 0, ChangeState]
type = ChangeState
trigger1 = (command = "holdup")
value = 1705 ;upwards

;-----------
;Decider
[State 0, ChangeState]
type = ChangeState
trigger1 = (p2bodydist x = [-80,80]) && (enemynear, pos y) < pos y && random >= 500
value = 1705 ;upwards

[State 0, ChangeState1]
type = ChangeState
trigger1 = p2bodydist x < -80 && (enemynear, pos y) < -120
value = 1706 ;left up

[State 0, ChangeState2]
type = ChangeState
trigger1 = p2bodydist x > 80 && (enemynear, pos y) < -120
value = 1701 ;up right

[State 0, ChangeState3]
type = ChangeState
trigger1 = p2bodydist x > 10 && (enemynear, pos y) > -80
value = 1704 ;right across

[State 0, ChangeState4]
type = ChangeState
trigger1 = p2bodydist x < -10 && (enemynear, pos y) > -80
value = 1702 ;left across

[State 0, ChangeState]
type = ChangeState
trigger1 = 1   ;a backup
value = 1705 ;upwards

