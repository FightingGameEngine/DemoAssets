[State -2, VS_Combo] 
type = VarAdd 
trigger1 = enemynear, time = 0 
trigger1 = enemynear, Hitshakeover = 0 
trigger1 = p2stateno = 6300 || p2stateno = [5000,5899] 
trigger2 = var(13)=-1 && (movehit || p2stateno = 6300 || p2stateno = [5000,5899]) 
var(13) = 1 + (var(13)=-1) 
ignorehitpause = 1 

[State -2, VS_Combo] 
type = VarSet 
trigger1 = var(13)!=-1 && (p2movetype!=H || enemynear, ctrl) 
trigger2 = var(13)=-1 && stateno = [5000,5899] 
var(13) = 0 - (roundstate<2) 
ignorehitpause = 1 

[State -2, VS_Combo] 
type = VarSet 
triggerall = numexplod(8701)!=0 
trigger1 = var(13)=0 
var(14) = 0 
ignorehitpause = 1 

[State -2, Score] 
type = Varadd 
trigger1 = enemynear, time=0 
trigger1 = enemynear, Hitshakeover=0 
trigger1 = moveguarded || p2stateno = 6300 || p2stateno = [5000,5899] 
trigger2 = var(13)=-1 && (movehit || p2stateno = 6300 || p2stateno = [5000,5899]) 
trigger3 = roundstate=4 && time=0 && stateno = [180,189] 
var(16) = ceil(stateno/50)*var(13) + (life)*(roundstate=4) + (moveguarded) 
ignorehitpause = 1 

[State -2, Normalize Score] 
type = Varset 
triggerall = numpartner=1 
trigger1 = var(16)< partner, var(16) 
var(16) = partner, var(16) 

[State -2, Is Danger] 
type = VarSet 
trigger2 = var(15) = 0 && life <= 250 
trigger1 = var(15) = 1 && roundstate!=2 
var(15) = (roundstate>1) 
ignorehitpause = 1 

[State -2, Is First Attack p3] 
type = VarSet 
triggerall = numpartner=1 
trigger1 = partner, movehit 
trigger1 = partner, var(13) != -1 
var(13) = 0 
ignorehitpause = 1 


;Telekinetic Hyper

[State -2, After Image]
type = afterimage
trigger1 = numexplod(3301)>0 && Time%80 = 0
time = 80
ignorehitpause = 1
PalBright = 0, 0, 0
PalContrast =  47,114,251;255,50,50
PalAdd = 0, 0, 0
PalMul = 1,1,1
trans = none
Length = 20
FrameGap = 4

[State -2, Set Powered Up Attack]
type = AttackMulSet
trigger1 =  var(19) = 3
value = 1.1

[State -2, Set Powered Up Attack]
type = AttackMulSet
trigger1 =  var(19) = 0
value = 1

[State -2, VarSet]
type = VarSet
trigger1 = var(19)!= 0 && numexplod(3301) = 0
v = 19
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = var(19)!= 3 && numexplod(3301) > 0
v = 19
value = 3

[State -2, PalFX]
type = PalFX
triggerall = timemod = 20,0
trigger1 = numexplod(3301) > 0
trigger2= stateno = 100
trigger3= stateno = 110
time = 50
add = 0,0,60
color = 256;128
sinadd = 0,0,60,50
ignorehitpause = 1

;Remove Hyper Explodes

[State -2, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(3301)>0
trigger1 = lose
id = 3301

[State -2, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(3302)>0
trigger1 = lose
id = 3302
