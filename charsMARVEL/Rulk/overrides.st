;---------------------------------------------------------------------------
;CAMERA FOCUS
[Statedef 6001]
type = S
physics  = S
anim = 0
ctrl = 0

[state 6001,TURN]
type=turn
trigger1=ishelper(6001)
trigger1=facing!=root,facing
ignorehitpause=1

[State 6001,vel]
type = VelSet
trigger1 = parent,pos X > 0
x = ifelse(facing = 1,4,-4)
[State 6001,vel]
type = VelSet
trigger1 = parent,pos X < 0
x = ifelse(facing = 1,-4,4)
[State 6001,vel]
type = VelSet
trigger1 = parent,pos X = [-5,5]
x = 0

[State 6001, WIDTH]
type = Width
trigger1 = 1
value = 1,1

[State 6001, NHB]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 6001,AS]
type = AssertSpecial
Trigger1 = 1
flag = invisible
flag2 = noshadow

[State 6001,Bound]
type = ScreenBound
trigger1 =1
value =1
movecamera = 320,0
[State 6001,push]
type = PlayerPush
trigger1 =1
value = 0

[State 6001, Destroyself]
type = destroyself
trigger1 = Time = 50
trigger1 = enemy, Life >= 1
trigger2=numhelper(6001)>=2
;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, WINKO]
type = Helper
triggerall = (WinKO) && (!NumHelper(12000)) && (enemy,time=1)
trigger1 =(StateNo = [3000,3600])
trigger2 = StateNo = 78120
helpertype = Normal
name = "WinKO"
id = 12000
pos = 0,-1500
postype = back
bindtime = -1
facing = 0
stateno=12000
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1


[State -2, debug]
type = DisplayToClipboard
trigger1 = Alive
text = "Rulk"



[State -2, dizzy stars]
type = Explod
trigger1 = (Anim = 5300) && (NumExplod(5301) = 0)
anim = 5301
ID = 5301
bindtime = -1
removetime = -1
sprpriority = 4
ownpal = 0

[State -2, nodizzy]
type = RemoveExplod
trigger1 = (Anim != 5300) && (NumExplod(5301) > 0)
ID = 5301

[State -2, killHyperBG]
type = VarSet
trigger1 = (sysvar(3) = 1) && (NumHelper(3010) = 0)
sysvar(3) = 0

[State -2, landing sound]   ; custom landing sound
trigger1 = (stateno = 52) && (Time = 1)
type = PlaySnd
persistent = 0
value = 8,1

[State -2, landing envshake]   ; custom landing action
trigger1 = (stateno = 52) && (Time = 1) && (prevstateno != 100)
type = EnvShake
time = 20
freq = IfElse(Var(3) = 1, 40, 60)
ampl = IfElse(Var(3) = 1, -7, -4)

[State -2, gethits]         ; custom gethit sounds
type = PlaySnd
triggerall = alive && (Time = 1)
triggerall = random < 300
trigger1 = stateno = [5000,5022] ; standing hard hit high
trigger2 = stateno = 5030   ; air hit
trigger3 = stateno = 5070   ; tripped
channel = 1
value = 4,0


; Rage palfx (Generated by Fighter Factory PalFX Editor)
[State -2, PalFXWiz]
type = PalFX
trigger1 = Var(5) && GameTime % 20 = 0 && RoundState = 2
time = 20
add = 80,-50,-50
mul = 256,24,24
sinadd = 80,0,0,20
invertall = 0
color = 0

; decrement rage timer
[State -2, VarSet]
type = VarSet
trigger1 = Var(5) && GameTime % 2 = 0
var(5) = var(5) - 1

; Rage hyper: reset damage multiplier when expired
[State 3810, AttackMulSet]
type = AttackMulSet
trigger1 = !Var(5)
value = 1




