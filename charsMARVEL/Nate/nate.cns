triggerall = var(9) !=1
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 3]
type = VarSet
triggerall = var(9) !=1
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
triggerall = var(9) !=1
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
triggerall = var(9) !=1
trigger1 = sysvar(0)
y = 0

[State 132, 6]
