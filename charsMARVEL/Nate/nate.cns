triggerall = var(9) !=1
trigger1 = sysvar(0)
trigger1 = var(59)=0 && roundstate=2 && command = "holdback"
trigger1 = inguarddist
value = 130

[State 132, 7]
type = ChangeState
triggerall = var(9) !=1
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
triggerall = var(9) !=1
trigger1 = var(59)=0 && roundstate=2 && command != "holdback"
trigger2 = !inguarddist
value = 140

