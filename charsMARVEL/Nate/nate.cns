[Data]
life = 1000           
attack = 100         
defence = 100        
fall.defence_up = 50 
liedown.time = 60    
airjuggle = 15       
sparkno = 0        
guard.sparkno = 0 
KO.echo = 0          
volume = 50

[Size]
xscale = 1           
yscale = 1           
ground.back = 15     
ground.front = 15     
air.back = 12        
air.front = 12       
z.width = 3          
attack.width = 4,4   
attack.dist = 160    
proj.attack.dist = 90 
head.pos = -20,-92
mid.pos = -7,-64
;height = 50

[Velocity]
walk.fwd  = 2.7      
walk.back = -2.7     
run.fwd  = 6.3    
run.back = -6.3 
jump.neu = 0,-9   
jump.back = -2.3    
jump.fwd = 2.5       
runjump.back = -6,-4 
runjump.fwd = 6,-4

airjump.neu = 0,-8.1      ;空中ジャンプ時の垂直移動速度  (オプション)
airjump.back = -3.55,-8.1 ;空中で後ろにジャンプした時の水平移動速度
airjump.fwd = 3.5,-8.1    ;空中で前にジャンプした時の水平移動速度

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .44         
stand.friction = .85  
crouch.friction = .82      

