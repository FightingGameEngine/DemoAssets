;**********************************************************;
;******************** KIT MVC SUPER JUMP ******************:
;**********************************************************;
		
;Super Jump
[Statedef 9996]
type = A
movetype = I
physics = N
anim = 40
velset = 0,0
ctrl = 0
sprpriority=1

[State 9996, 6]		;---> SUPER JUMP SOUND
type = PlaySnd
trigger1 = Time = 0
value = S1000,1

[State 0, Explod]	;---> SUPER JUMP DUST
type = Explod
trigger1 = AnimTime = 0
anim = 9997
ID = 9997
pos = 0,20
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -2
supermove =999
pausemove =999
scale = .5,.5
sprpriority = 3
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 1
ignorehitpause = 1
persistent = 0

[State 9996, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 9996, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 9996, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 9996, 4]
type = VelSet
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*1.5 ; you can change these value, to make it fit how you want the superjump

[State 9996, 5]
type = ChangeState
trigger1 = animtime = 0
value = 50
ctrl = 1

