;---------------------------------------------------------------------------
; Description: throws are not Difficult to make, although then can be
;     tedious at times. throw attempt states have a hitdef of a
;     special Format. the key parameters in a throw are p1stateno
;     and p2stateno. if the hitdef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. the special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state File. in this case, no matter who the
;     opponent is, he will be taken to state 820 of this File (kfm.cns)
;     and remain here Until the end of the throw (look at his Debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state File).
;---------------------------------------------------------------------------
; Throw
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State 800, PlaySnd]
type = PlaySnd
trigger1 =  AnimElem = 2
value = 999,5

[State 800, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NT
hitflag = M-
priority = 1, Miss
sparkno = -1
sprpriority = 2
;p1facing = ifelse(command="holdfwd",1,-1)
p1stateno = 810
p2stateno = 820
guard.dist = 0
fall.xvelocity = 0
fall.yvelocity = 0
fall = 0
fall.recover = 0
fall.damage = 80

[State 800, ChangeState]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
sprpriority = 2

[State 810, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 810, TargetBind]
type = TargetBind
trigger1 = time = 0
time = 1
id = -1
pos = 30,-30

[State 810, TargetLifeAdd]
type = TargetLifeAdd
trigger1 = AnimElem = 2
value = -7

[State 810, TargetState]
type = TargetState
trigger1 = time = 40
value = 830

[State 810, ChangeState]
type = ChangeState
trigger1 = time = 40
value = 811
ctrl = 0

[Statedef 811]
type    = S
movetype= I
physics = S
velset = 0,0
anim = 811
sprpriority = 0

[State 811, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 811, PlaySnd]
type = PlaySnd
trigger1 = animelemtime(4)=0
value = S999,4

[State 811, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,-1.1
sprpriority = 0

[State 820, ChangeAnim2]
type = ChangeAnim2
trigger1 = Time = 0
value = 820

[State 820, PosAdd]
type = PosAdd
trigger1 =  time = 0
y = -50

[State 820, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[Statedef 830]
type    = A
movetype= H
physics = N
velset = 17,-3
poweradd = 50

[State 830, ChangeAnim2]
type = ChangeAnim2
trigger1 = (Time = 0)
value = 830

[State 830, PosAdd]
type = PosAdd
trigger1 = Time = 0
Y = 45

[State 830, VelAdd]
type = VelAdd
trigger1 = Time >= 1
Y = 0.5

[State 830, SelfState]
