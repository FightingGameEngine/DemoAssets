;---------------------------------------------------------------------------
; win pose vs cyclops
[statedef 184]
type = s
movetype = a
physics = n
anim = 1830

[state 184, 1]
type = velset
trigger1 = time = 0
x = const(velocity.walk.fwd.x)

[state 184, 2]
type = velset
trigger1 = abs(screenpos x - enemynear,screenpos x) < 73
x = 0

[state 184, 3]
type = posadd
trigger1 = anim = 183 && animelem = 1
x = 73 - ( enemynear,screenpos x - screenpos x)

[state 184, 4]
type = changeanim
trigger1 = vel x = 0 && anim != 183
value = 183

;---------------------------------------------------------------------------
; Introduction
[statedef 190]
type = s
ctrl = 0
velset = 0,0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
v = 28    ;fv = 10
value = (PalNo)
;persistent =

[state 190, intro]
type = assertspecial
trigger1 = 1
flag = intro

[state 190, 1]
type = changestate
trigger1 = time = 1 && p2name = "cyclops"
trigger2 = time = 1 && p2name = "[vanessa]'s cyclops"
value = 193

[state 190,intro Decider]
type = changestate
trigger1 = time = 1
value = 191 + ((random * 2) / 1000); change the 1 to however many intros you have

