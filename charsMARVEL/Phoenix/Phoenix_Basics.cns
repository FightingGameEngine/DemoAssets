;---------------------------------------------------------------------------
;-------------------------------[ states ]----------------------------------
;---------------------------------------------------------------------------
; lose by time over
[statedef 170]
type = s
ctrl = 0
anim = 170
velset = 0,0

[State 170,0]
type = PlaySnd
trigger1 = Time = 0
value = 170,0
channel = 5
volume = 255

[state 170, 1]
type = nothitby
trigger1 = 1
value = sca
time = 1
;---------------------------------------------------------------------------
; lose by Draw
[statedef 175]
type = s
ctrl = 0
anim = 175
velset = 0,0

[State 175,0]
type = PlaySnd
trigger1 = Time = 0
value = 175,0
channel = 5
volume = 255

[state 175, 1]
type = nothitby
trigger1 = 1
value = sca
time = 1
;---------------------------------------------------------------------------
; win state Decider
[statedef 180]
type = s
ctrl = 0
velset = 0,0

[state 180, 3]
type = changestate
trigger1 = var(20) = 1 && time = 0
value = 183

[state 180, winpose Decider]
type = changestate
trigger1 = var(20) = 0 && time = 0
value = 181 + ((random * 2) / 1000)     ; change the 1 to however many winposes you have

;---------------------------------------------------------------------------
; win pose 1
[statedef 181]
type = s
ctrl = 0
anim = 181
velset = 0,0

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 5
range = 0,2

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 0
trigger1 = animelem = 5
value = S180,0
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 1
trigger1 = animelem = 5
value = S180,1
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 2
trigger1 = time = 1
value = S180,2
volume = 255
channel = 5

[State 181,1]
type = AssertSpecial
trigger1 = Time = [0,250]
flag = RoundNotOver

;---------------------------------------------------------------------------
; win pose 2
[statedef 182]
type = s
ctrl = 0
anim = 182
velset = 0,0

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 5
range = 0,1

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 0
trigger1 = time = 1
value = S180,3
volume = 255
channel = 5

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(5) = 1
trigger1 = time = 6
value = S180,4
volume = 255
channel = 5

[State 182,1]
type = AssertSpecial
trigger1 = Time = [0,180]
flag = RoundNotOver

