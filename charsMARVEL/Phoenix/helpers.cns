stateno = 7500
;ID = 7500
name = "Flames"
postype = p2
bindtime = -1; 1000
ownpal = 1
facing = 1
pos = 25,-30
size.ground.front = 0
size.ground.back = 0
ignorehitpause = 1
persistent = 0

[State 1010, End]
type = DestroySelf
trigger1 = time >= 0
