; Apocalypse States
;---------------------------------------------------------------------------
; Stand
[Statedef 10000]
type = S
movetype = I
physics = S
anim = 10000
velset = 0,0

[State 10000, 0]
type = PosSet
trigger1 = Pos Y != 0
y = 0

;---------------------------------------------------------------------------
; Crouch
[Statedef 10010]

[State 10010, Dash]
type = ChangeState
value = 10105
triggerall = Var(10040) > 0
triggerall = Var(10040) < 10
;trigger1 = P2Dist X >= -300
trigger1 = P2Dist X <= -200
trigger2 = P2BodyDist X > 0
trigger2 = P2BodyDist X < 10

[State 10010, Dash]
type = ChangeState
value = 10100
triggerall = Var(10040) > 0
triggerall = Var(10040) < 10
trigger1 = P2BodyDist X >= 400
;trigger1 = P2BodyDist X <= 500

[State 10010, 0]
type = ChangeState
trigger1 = 1
value = 10000
ctrl = 1

;---------------------------------------------------------------------------
; Walk
[Statedef 10020]
type    = S
physics = S

[State 10020, 1]
type = VelSet
triggerall = Time < 15
triggerall = command = "holdfwd"
trigger1 = P2BodyDist X < 0
trigger2 = P2BodyDist X >= 0
trigger2 = FrontEdgeDist >= 150
x = Const(movement.stand.friction)

[State 10020, 2]
type = VelSet
triggerall = Time < 15
triggerall = command = "holdback"
trigger1 = P2BodyDist X > 0
trigger2 = P2BodyDist X <= 0
trigger2 = BackEdgeDist >= 150
x = Const(movement.stand.friction)

[State 10020, 3]
type = PosAdd
triggerall = Time > 0
triggerall = Time <= 15
trigger1 = TimeMod = 3,0
y = -1

[State 10020, 4]
type = PosAdd
trigger1 = Time > 15
trigger1 = Time <= 20
y = 1

[State 10020, 5]
type = PosSet
trigger1 = Time <= 0
trigger2 = Time >= 20
y = 0

[State 10020, 6]
type = ChangeState
trigger1 = Time >= 20
value = 10021

;---------------------------------------------------------------------------
; Walk Stop
[Statedef 10021]
type    = S
physics = S
velset = 0,0
ctrl = 0

[State 10021, 0]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[State 10021, 1]
type = PlaySnd
trigger1 = Time = 0
value = 0, 0

[State 10021, 2]
type = EnvShake
trigger1 = Time = 0
time = 30
freq = 100
ampl = -4

[State 10021, 3]
type = ChangeState
triggerall = Time > 20
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
value = 10020
ctrl = 1

[State 10021, 4]
type = ChangeState
triggerall = Time > 20
trigger1 = command != "holdfwd"
trigger2 = command != "holdback"
value = 10000
ctrl = 1

;---------------------------------------------------------------------------
; Jump
[Statedef 10040]

[State 10040, Dash]
type = ChangeState
value = 10105
triggerall = Var(10040) > 0
triggerall = Var(10040) < 10
;trigger1 = P2Dist X >= -300
trigger1 = P2Dist X <= -200
trigger2 = P2BodyDist X > 0
trigger2 = P2BodyDist X < 10

[State 10040, Dash]
type = ChangeState
value = 10100
triggerall = Var(10040) > 0
triggerall = Var(10040) < 10
trigger1 = P2BodyDist X >= 400
;trigger1 = P2BodyDist X <= 500

[State 10040, 0]
type = ChangeState
trigger1 = 1
value = 10000
ctrl = 1

;---------------------------------------------------------------------------
; Dash Fwd
[Statedef 10100]
type    = S
physics = S
velset = 0,0
ctrl = 0

[State 10100, 0]
type = EnvShake
trigger1 = Time = 0
time = 80
freq = 100
ampl = -2

[State 10100, 1]
type = VelSet
triggerall = Time >= 10
triggerall = Time < 40
trigger1 = P2BodyDist X < 0
trigger2 = P2BodyDist X >= 0
trigger2 = FrontEdgeDist >= 150
x = const(velocity.run.fwd.x)

[State 10100, 2]
type = ChangeState
trigger1 = Time >= 50
value = 10000
ctrl = 1

;---------------------------------------------------------------------------
; Dash Back
[Statedef 10105]
type    = S
physics = S
velset = 0,0
ctrl = 0

[State 10105, 0]
type = EnvShake
trigger1 = Time = 0
time = 80
freq = 100
ampl = -2

[State 10105, 1]
type = VelSet
triggerall = Time >= 10
triggerall = Time < 40
trigger1 = P2BodyDist X > 0
trigger2 = P2BodyDist X <= 0
trigger2 = BackEdgeDist >= 150
x = const(velocity.run.back.x)

[State 10105, 2]
type = ChangeState
trigger1 = Time >= 50
value = 10000
ctrl = 1

