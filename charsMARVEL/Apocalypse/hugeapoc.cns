trigger1 = RoundNo = 1
fvalue = 0

[State 15900, 3] ;Intro
type = ChangeState
trigger1 = RoundNo = 1
;trigger1 = Time = 300
value = 10190

[state 15900, 4] ;Turns Mode Intro
type = ChangeState
trigger1 = RoundsExisted = 0 && TeamMode = Turns && Roundno > 1
