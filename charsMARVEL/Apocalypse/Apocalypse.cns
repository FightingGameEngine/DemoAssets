trigger1 = 1
text = "var(2)=%d, var(1)=%d, var(50)=%d, var(59)=%d, p2bodydist y=%d"
params = var(23), var(1), var(50), var(59), floor(p2bodydist y)



;;;character transformation
[State -2, Transform Helper]
type = Helper
trigger1 = numhelper(8874) = 0
name = "AmITransformed?"
ID = 8874
pos = 9999,-9999
stateno = 8874
     
[State -2, Transform Helper]
type = Changeanim
triggerall = helper(8874),var(40) > 0
trigger1 = anim = [0,9999]
value = anim + helper(8874),var(40)*10000
;;;;;;;;;;;character transformation end

