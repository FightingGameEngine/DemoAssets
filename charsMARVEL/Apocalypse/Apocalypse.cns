;;;character transformation code
[Statedef 8874]
     
    [State 8874, OHNOES!]  ; You really don't want to see this helper do you?
    type = assertspecial
    trigger1 = time
    flag = invisible
    persistent = 1
     
    [state 8874, INIT] ; Initialize the transformation variable
    type = varset
    trigger1 = time = 0
    v = 40
    value = 0
     
    [State 8874, Change] ; This sctrl can be modified as appropriate
    type = varset
    triggerall = root, animelemtime(5) = 0  ; Halfway through the transformation anim in this case
    trigger1 = root, anim = 3100    ; Suppose the anim for transforming is 1000
    trigger2 = root, anim = 14000  ; Transforming back is anim 11000 in this case
    v = 40
    value = ifelse(root,anim=3100,1,0) ;1 = Transformed, 0 = not
;;;;;;;;;;;;;;;;;;;;;;;;;;character transformation code end


