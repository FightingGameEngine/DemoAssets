;---------------------------------------------------------------------------
; Lose (time over)
[Statedef 170]
type = S
ctrl = 0
anim = 175 ;184
velset = 0,0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = time = 1
value = 170,0
volume = 255
channel = 5

[State 182, Round Not Over Yet]
type = AssertSpecial
trigger1 = time < 400
flag = RoundNotOver

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Draw game (time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, PlaySnd]
type = PlaySnd
trigger1 = time = 1
value = 175,0
volume = 255
channel = 5

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 182, Round Not Over Yet]
type = AssertSpecial
trigger1 = time < 350
flag = RoundNotOver

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 184

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

