trigger1 = AnimElem = 3
value = 10, 3

[State 200,Exit]
type = PlaySnd
trigger1 =AnimElem = 5
value = 10 ,1
channel=1





[State 200,Hitdef]
type = HitDef
trigger1 = AnimElem = 9

attr = S, NA
damage    = 45
animtype = medium
air.animtype = back
guardflag = M
hitflag = MAF
pausetime = ceil(10-((var(21)>0)*10)/2),ceil(9-((var(21)>0)*9)/2)
sparkno = s7111
guard.sparkno = s7
sparkxy = -30,-50
hitsound = S1, 10
guardsound = S0, 0
ground.type = High
ground.slidetime = 11+var(14)*2
ground.hittime = 11
ground.velocity = -3
guard.velocity = -6.0+(((var(21))*6.0)/2)
air.velocity = -5.0,-6.0
yaccel = .5
air.cornerpush.veloff = 0
getpower = 4*var(5),2*var(5)
givepower = 2*var(6),2*var(6)
ground.cornerpush.veloff = -11.0+(((var(21))*11.0)/2)
guard.cornerpush.veloff = -11.0+(((var(21))*11.0)/2)
priority = 3,Hit
palfx.color = ifelse(fvar(1),60,255)
palfx.mul = ifelse(fvar(1),255,128),ifelse(fvar(1),255,128),ifelse(fvar(1),255,128)
palfx.time = ifelse(fvar(1),ifelse(P2statetype=A,40,20-(var(21)>0)*4),ifelse(var(14),10,0))
palfx.sinadd = 120,120,120,ifelse(fvar(1),3,0)
palfx.add = ifelse(fvar(1),0,255),ifelse(fvar(1),0,255),ifelse(fvar(1),0,255)


