;---------------------------------------------------------------------------
;気のオーラ
[Statedef 710]
type = A
movetype = I
physics = N
ctrl = 0
anim = 710
velset = 0,0
sprpriority = -1

[State 710]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 710]
type = BindToParent
trigger1 = anim = 710
pos = -20,0

[State 710]
type = DestroySelf
trigger1 = Root,StateNo != 701 && Root,StateNo != 10000
;---------------------------------------------------------------------------
;気のオーラ消滅
[Statedef 711]
type = A
movetype = I
physics = N
ctrl = 0
anim = 711
velset = 0,0
sprpriority = -1

[State 710]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 710]
type = BindToParent
trigger1 = anim = 711
pos = -20,0

[State 710]
type = DestroySelf
trigger1 = AnimTime = 0
;---------------------------------------------------------------------------
;アーマー
[Statedef 10000]
type = U
movetype = H
physics	= U

[State 10500]
type = PalFX
trigger1 = Time = 0
time = 5
add = 10,10,10

[State 9000]
type = ChangeState
trigger1 = time = 1
value = var(10)
ctrl = var(11)

[State 4810, PosFreeze]
type = PosFreeze
trigger1 = Life > 0
trigger1 = 1
ignorehitpause
value = 1

[State 4810, HITSHAKE] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = Anim
elem  = AnimElemNo(0)


[State 9000, vel1]
type = velset
trigger1 = prevstateno = 50
x= ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 9000, vel2]
type = velset
trigger1 = prevstateno = 106
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 4810, VelSet]
type = VelSet
trigger1 = Life = 0
x = GetHitVar(xvel)
y = GetHitVar(yvel)

[State -3]
type = VarAdd
trigger1 = time = 0
var(12) = 1

[State 9000]
type = ChangeState
trigger1 = var(12) = 5
value = 5000

[State 9000, dead]
type = ChangeState
triggerall = !alive
trigger1 = Life <= 0
value = 5150
;-----------------------------------------------------------------
;死亡
[Statedef 10010]
type = A
movetype = H
anim = 10010
ctrl = 0

[State 9010, 1]
type = VelSet
trigger1 = 1
x= -1
y= -1

[State 9010, 2]
type = gravity
trigger1 = time >= 30

[State 9010, 3]
type = ChangeState
trigger1 = time = 60
value = 5150

