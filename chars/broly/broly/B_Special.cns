;---------------------------------------------------------------------------
;特殊能力の記述です。
;---------------------------------------------------------------------------
; 気合溜め1
[Statedef 700]
type    = S
physics = S
velset = 0,0
ctrl = 0
sprpriority = 0
;anim = 0

[State 700]
type = ChangeAnim
trigger1 = PrevStateno != 10000
trigger1 = time = 0
value = 0

[State 700]
type = PlaySnd
trigger1 = time = 0
value = 180,3;700, 0
channel = 0

[State 700]
type = PlaySnd
trigger1 = time = 0
value = 700, 1
volume = 255

[State 700]
type = ChangeState
trigger1 = time = 1
value = 701
ctrl = 1
;---------------------------------------------------------------------------
; 気合溜め2
[Statedef 701]
type    = S
physics = S
velset = 0,0
ctrl = 0
sprpriority = 0
;anim = 700

[State 710]
type = Helper
trigger1 = (Time = 0) && (NumHelper(710) < 1)
id = 710
name = "Charge"
pos = -10,0
postype = P1
stateno = 710
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
size.xscale = 1.5
size.yscale = 1.5

[State 1002, landdust1]
type = explod
trigger1 = ((GameTime%27) = 0) && (NumExplod(700) < 1)
postype = p1
pos = -35,0
vel = -1,0
spacing = 1
sprpriority = 7
anim = 6200
ID=700
ownpal = 1
scale = 1.5, 1.5

[State 1002, landdust]
type = explod
trigger1 = ((GameTime%27) = 0) && (NumExplod(701) < 1)
postype = p1
pos = 5,0
vel = 1,0
facing = -1
spacing = 1
sprpriority = 7
anim = 6200
ID=701
ownpal = 1
scale = 1.5, 1.5

[State 700]
type = ChangeAnim
trigger1 = PrevStateno != 10000
trigger1 = time = 0
value = 700

[State 700]
type = PlaySnd
trigger1 = time = 10
value = 700, 2
channel = 1
loop = 1
pan = 1
volume = 25

[State 700]
type = PlaySnd
trigger1 = power >= 3000
value = 700, 1
pan = 1

[State 700]
type = poweradd
trigger1 = Time >= 0
value = 5

[State 700]
type = poweradd
trigger1 = Time >= 25
value = 6

[State 700]
type = poweradd
trigger1 = Time >= 75
value = 7

[State 700]
type = poweradd
trigger1 = Time >= 120
value = 8

[state 700]
type = envshake
trigger1 = time%5 = 0
time = 5
freq = 60
ampl = -2

[State 700]
type = PalFX
triggerall = Time >= 5
trigger1 = TimeMod = 4,0
trigger1 = Time > 0
time = 1
add = 100,100,100

[State 700]
type = ChangeState
trigger1 = power >= 3000
trigger2 = command != "hold_b" || command != "hold_y"
trigger2 = command != "hold_c"
value = 702
ctrl = 1
