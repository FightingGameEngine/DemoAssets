; 偙傟偼僇儞僼乕儅儞偺俠俶俽僼傽僀儖偱偡丅
; 僐儊儞僩傪嶲峫偵偟偰俠俶俽傪棟夝偟偰偔偩偝偄

; 偙傟偼KFM偺掕悢偲忬懺偺僼傽僀儖偱偡丅
; 愨懳婰擖偟丄嶍彍偼偟側偄偱偔偩偝偄丅
[Data]
  ;懱椡僎乕僕偺弶婜抣
life = 1700
  ;婥僎乕僕偺弶婜抣
power = 3000
  ;峌寕椡乮偙傟埲忋偵愝掕偡傞偲嫮偔側傞乯
attack = 100
  ;杊屼椡乮偙傟埲忋偵愝掕偡傞偲嫮偔側傞乯
defence = 110
  ;僐儞儃傪偔傜偭偰偄傞帪偵偁偑傞杊屼椡
fall.defence_up = 50
  ;搢傟偰偐傜婲忋偑傞傑偱偺僼儗乕儉悢
liedown.time = 60
  ;嬻拞偱偳傟偩偗僐儞儃偑宷偑傞偐乮崅偔偡傞偲柍尷僐儞儃偵側傞偺偱拲堄乯
airjuggle = 15
  ;hitdef偱愝掕偟偰偄側偄帪偺婎杮僸僢僩僗僷乕僋僫儞僶乕
sparkno = 2
  ;愝掕偟偰側偄帪偺僈乕僪僫儞僶乕
guard.sparkno = 40
  ;KO偟偨帪偵惡偵僄僐乕傪偐偗傞偐乮侾偱俷俶乯
KO.echo = 0
 volume = 0
  IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;悈暯曽岦偺弅広乮捠忢侾乯
yscale = 1           ;悅捈曽岦偺弅広乮捠忢侾乯
ground.back = 20     ;僉儍儔偺暆(屻曽,抧忋)
ground.front = 21    ;僉儍儔偺暆(慜曽,抧忋)
air.back = 17        ;僉儍儔偺暆(屻曽,嬻拞)
air.front = 17       ;僉儍儔偺暆(慜曽,嬻拞)
height = 110          ;僉儍儔偺崅偝
attack.dist = 160    ;峌寕傪偟偨帪憡庤偑僈乕僪懱惂偵擖傞嵟掅嫍棧
proj.attack.dist = 90;峌寕傪偟偨帪憡庤偑僈乕僪懱惂偵擖傞嵟掅嫍棧乮旘傃摴嬶乯
proj.doscale = 0     ;忋偱愝掕偟偨弅広傪旘傃摴嬶偵傕揔梡偡傞偐乮侾偱俷俶乯   
head.pos = -5, -90   ;摢偺戝懱偺嵗昗
mid.pos = -5, -60    ;懱偺拞怱偺戝懱偺嵗昗
shadowoffset = 0     ;塭偺悅捈曽岦偺僆僼僙僢僩
draw.offset = 0,0    ;巊梡偟側偄

[Velocity]
walk.fwd  = 1.4      ;慜恑偺懍搙
walk.back = -1.2     ;屻戅偺懍搙
run.fwd  = 4.6, 0    ;慜僟僢僔儏偺懍搙乮儂僢僾偡傞帪偼y傪-偵偡傞乯
run.back = -4.5,-3.8 ;屻僟僢僔儏偺懍搙乮儂僢僾偡傞帪偼y傪-偵偡傞乯
jump.neu = 0,-8.4    ;悅捈僕儍儞僾偺懍搙
jump.back = -2.55    ;屻僕儍儞僾偺懍搙
jump.fwd = 2.5       ;慜僕儍儞僾偺懍搙
runjump.back = -2.55,-8.1 ;屻僟僢僔儏偟側偑傜偺僕儍儞僾懍搙(僆僾僔儑儞)
runjump.fwd = 4,-8.1      ;慜僟僢僔儏偟側偑傜偺僕儍儞僾懍搙(僆僾僔儑儞)
airjump.neu = 0,-8.1      ;俀抜僕儍儞僾埲崀偺悅捈僕儍儞僾偺懍搙(僆僾僔儑儞)
airjump.back = -2.55      ;俀抜僕儍儞僾埲崀偺屻僕儍儞僾偺懍搙(僆僾僔儑儞)
airjump.fwd = 2.5         ;俀抜僕儍儞僾埲崀偺慜僕儍儞僾偺懍搙

[Movement]
airjump.num = 1      ;嬻拞偱僕儍儞僾偡傞夞悢
airjump.height = 35  ;嬻拞偱僕儍儞僾偡傞嵟掅尷偺崅偝
yaccel = .44         ;廳椡
stand.friction = .85  ;棫偪忬懺偺杸嶤學悢
crouch.friction = .82 ;孅傒忬懺偺杸嶤學悢

;---------------------------------------------------------------------------
; 僗僥僀僩偺夝愢
; [Statedef STATENO]
; type = ?      S/C/A/L  俽丗棫偪/俠丗孅傒/俙丗嬻拞/俴丗僟僂儞
; movetype = ?  I/A/H    俬丗捠忢忬懺/俙丗峌寕忬懺/俫丗僟儊乕僕傪偔傜偭偰傞忬懺
; physics = ?   S/C/A/N  俽丗棫偪/俠丗孅傒/俙丗嬻拞/俶丗柍偟
; juggle = ?             偦偺峌寕偵巊偆僕儍僌儖悢
;
;---------------------------------------------------------------------------
; 偙偙偐傜壓偼-3偺僗僥乕僩傪彂偄偰偔偩偝偄丄偙偙偵彂偄偨傕偺偼僎乕儉拞
; 偵忦審偑惉棫偡傟偽偄偮偱傕奐巒偡傞僗僥乕僩偱偡丅
;---------------------------------------------------------------------------
;-------------------------------------------------------------
;-------------------------------------------------------------
; ------------------僕儍儞僾奐巒
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 40, longjump];儘儞僌僕儍儞僾
type = VarSet
trigger1 = command = "longjump"
trigger2 = prevstateno = 101 && command = "holdfwd"
trigger3 = prevstateno = 252 && command = "holdup"
trigger4 = prevstateno = 525 && command = "holdup"
var(5) = 1

[State 40, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

; --------------------忋曽僕儍儞僾
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = VelSet
trigger1 = Time = 0 && Var(5)
x = IfElse(vel x = 0,0,IfElse(vel x < 0,-5,6))
y = -12

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))


[State 50,line1];僗僺乕僪儔僀儞侾
