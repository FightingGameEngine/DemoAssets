triggerall = Var(5) && Vel X != 0
trigger1 = Time % 4 = 0 && Time < 30
anim = 4053
postype = p1
pos = 10, -60
velocity = 0, 0
accel = 0, 0
random = 20, 20
removetime = -2
ownpal = 1

