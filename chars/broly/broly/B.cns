;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, DEBUG]
trigger1 = 1
type = DisplayToClipboard
ignorehitpause = 1
text = "miaoyu && choujin"

;===========================================================
;-------------------------------------------------------------------
;反闪身
[State 0, VarSet]
type = VarSet
triggerall = !ishelper
trigger1 = (p2stateno = 4305 || p2stateno = 4306)  && var(53) = 0
var(53) = 1
ignorehitpause = 1

[State 0, Varset]
type = Varset
trigger1 = var(53) =0
trigger2 = (stateno = 4305 || stateno = 4306)          ;-----------BK成功
trigger3 = stateno >= 5000                                        ;-----------挨打
trigger3 = time > 0
trigger4 = stateno <200                                             ;-----------不成功也没有挨打
trigger4 = time > 0
var(53) = 0
ignorehitpause = 1
;------------------------
;blocking
[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) >= 10
trigger2 = (stateno = [4000,4020]) && time = 1
var(56) = 0

[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) >= 10
trigger2 = (stateno = [4000,4020]) && time = 1
var(54) = 0

[State -2, Blocking-1]
type = VarAdd
trigger1 = var(54)
var(54) = 1
ignorehitpause = 1

[State -2, Blocking-1]
type = VarSet
triggerall = !var(59)
triggerall = !var(54)
trigger1 = command = "holdfwd" && command != "holddown"&& Command != "holdup"
var(54) = 1

[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) = [1,4]
trigger1 = command != "holdfwd" && Command != "holdback" && command != "holdup" && Command != "holddown"
var(56) = 1

[State -2, Blocking-1]
type = VarSet
trigger1 = var(55) >= 20
trigger2 = (stateno = [4300,4305]) && time = 1
var(57) = 0

[State -2, Blocking-2]
type = VarSet
trigger1 = var(55) >= 20
trigger2 = (stateno = [4300,4305]) && time = 1
var(55) = 0

[State -2, Blocking-2]
type = VarAdd
trigger1 = var(55)
var(55) = 1
ignorehitpause = 1

[State -2, Blocking-2]
type = VarSet
triggerall = !var(59)
triggerall = !var(55)
trigger1 = command = "holddown" && command != "holdfwd"&& Command != "holdback"
var(55) = 1

[State -2, Blocking-2]
type = VarSet
trigger1 = var(55) = [1,4]
trigger1 = command != "holdfwd" && Command != "holdback" && command != "holdup" && Command != "holddown"
var(57) = 1

;闪身慢动作
[State 0, Pause]
type = Pause
triggerall = !ishelper
trigger1 = (stateno = [4305,4306]) || stateno = 4303
trigger1 = gametime%4 = 0
time = 1
ignorehitpause = 1

;反闪身BK
[State -2, 4020]
type = HitOverride
triggerall = var(53) = 1 && P2MoveType = A && power >=1000
;triggerall = Enemy,var(7) != 0 && Enemy,var(8) < 2                           ;----------慢动作BK不能
trigger1 = (var(54) = [1,4]) && !var(59)
trigger2 = (var(54) = [5,8]) && var(56) && !var(59)
trigger3 = Random <= (450+(var(12)*10)) && var(59)
slot = 0
stateno = 4306
attr = SCA, AA, AP
time = 2

;地面受击中段BK
[State -2, 4020]
type = HitOverride
triggerall = var(53) = 0
triggerall = stateno = [5000,5030)
triggerall = P2stateno = [200,1000)
