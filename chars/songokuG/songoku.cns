triggerall=!ishelper
triggerall=roundstate=[0,1]
triggerall=enemynear,roundno=1
trigger1=enemy(ifelse(!(enemy,teammode=simul),0,enemy,name!="MG_Snorlax")),name="MG_Snorlax"
trigger1=enemy(ifelse(!(enemy,teammode=simul),0,enemy,name!="MG_Snorlax")),stateno=9502
trigger1=enemynear,var(9)=1
value=s1000,0	;ここに数字を入れてください
[state ,出現Explod]
