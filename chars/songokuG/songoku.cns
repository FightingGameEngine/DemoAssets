; イントロ
;---------------------------------------------------------------------------
[Statedef 190, イントロステート]
type = S

;Iwakick氏特殊イントロ用
[State 191]
type=ChangeState
triggerall=numenemy&&prevstateno!=100191
triggerall=(!(teammode=turns)&&roundno=1)||teammode=turns
trigger1=enemy,authorname="iwakick"
trigger1=enemy,animexist(18000)
trigger1=enemy,stateno!=192
value=100191
persistent=256
ignorehitpause=1

[State 190, 2]
type = ChangeState
triggerall = Time = 0
trigger1 = enemy,name != "Golden_Frieza"
trigger1 = enemy,name != "Frieza"
trigger1 = enemy,name != "Recoom"
trigger1 = enemy,name != "Burter"
trigger1 = enemy,name != "Guldo By Tomo"
trigger1 = enemy,name != "vegeta"
trigger1 = enemy,name != "vegeta"
trigger1 = enemy,name != "Vegeta by Komodo"
trigger1 = enemy,name != "Vegeta by OverMind"
trigger1 = enemy,name != "KiKi's Vegeta"
trigger1 = enemy,name != "Vegeta Normal 2 by EB"
trigger1 = enemy,name != "Vegeta Z2"
