trigger1=enemy(ifelse(!(enemy,teammode=simul),0,enemy,name!="MG_Snorlax")),stateno=59999
anim=0		;変更不要です。
id=55556		;このidで確認するので、変更しないでください
pos=0,12000
removetime=60
[state ,鳴き声]
