;反闪身
[State 0, VarSet]
type = VarSet
triggerall = !ishelper
trigger1 = (p2stateno = 4305 || p2stateno = 4306)  && var(53) = 0
var(53) = 1
ignorehitpause = 1

[State 0, Varset]
type = Varset
trigger1 = var(53) =0
trigger2 = (stateno = 4305 || stateno = 4306)          ;-----------BK成功
trigger3 = stateno >= 5000                                        ;-----------挨打
trigger3 = time > 0
trigger4 = stateno <200                                             ;-----------不成功也没有挨打
trigger4 = time > 0
var(53) = 0
ignorehitpause = 1
;------------------------
;blocking
[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) >= 10
trigger2 = (stateno = [4000,4020]) && time = 1
var(56) = 0

[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) >= 10
trigger2 = (stateno = [4000,4020]) && time = 1
var(54) = 0

[State -2, Blocking-1]
type = VarAdd
trigger1 = var(54)
var(54) = 1
ignorehitpause = 1

[State -2, Blocking-1]
type = VarSet
triggerall = !var(59)
triggerall = !var(54)
trigger1 = command = "holdfwd" && command != "holddown"&& Command != "holdup"
var(54) = 1

[State -2, Blocking-1]
type = VarSet
trigger1 = var(54) = [1,4]
trigger1 = command != "holdfwd" && Command != "holdback" && command != "holdup" && Command != "holddown"
var(56) = 1

[State -2, Blocking-1]
type = VarSet
trigger1 = var(55) >= 20
trigger2 = (stateno = [4300,4305]) && time = 1
var(57) = 0

[State -2, Blocking-2]
