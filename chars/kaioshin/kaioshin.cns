yscale = 1.05
ground.back = 20
ground.front = 20
air.back = 20
air.front = 20
height = 105
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0, -95
mid.pos = -0, -65
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 4.3
walk.back = -3.3
run.fwd  = 7.3, 0
run.back = -6.6,-4.5
jump.neu = 0,-11
jump.back = -3.27
jump.fwd = 3.27
runjump.back = -4,-10
runjump.fwd = 4,-12
airjump.neu = 0,-9.1
airjump.back = -3.55
airjump.fwd = 3.5

[Movement]
