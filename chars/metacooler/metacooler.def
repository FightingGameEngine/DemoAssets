; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Meta Cooler"        ;Name of character
displayname = "Meta Cooler" ;Name of character to display
versiondate = 21,04,2013    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Gladiacloud"         ;Character author name
pal.defaults = 1            ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = metacooler.cmd           ;Command set
cns     = metacooler.cns           ;Constants
st      = metacooler.cns           ;States
st1     = attacks.cns       ;States
st2     = specials.cns       ;States
st3     = hypers.cns       ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = metacooler.sff           ;Sprite
anim    = metacooler.air           ;Animation
sound   = metacooler.snd           ;Sound

[Palette Keymap]
x = 1 
y = 2
z = 1
a = 2
b = 1
c = 2