;--------------------------------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;  並列混線ヘルパーメモリ確保用ダミーヘルパー + 並列混線被弾ヘルパー生成
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;--------------------------------------------------------------------------------------------------
;  並列混線ヘルパーメモリ確保用ダミーヘルパーを生成。
;  並列混線被弾ヘルパー1から生成する並列混線ヘルパー1の領域を確保しておく。
;  並列混線被弾ヘルパーと交互に同じものを24個生成。

[State -2, 並列混線占有1]
type = Helper
triggerall = palno = 12
triggerall = !IsHelper
triggerall = enemynear,name != "OmegaTH";トムが相手の時には出さないように設定
triggerall = enemynear,name != "Xibalba"
triggerall = enemynear,name != "G-Dialga"
triggerall = enemynear,name != "Itzamna"
triggerall = enemynear,name != "Ultimate_Cell"
triggerall = enemynear,name != "Arcadia"
triggerall = enemynear,name != "Sirius"
triggerall = enemynear,name != "Kukulkan"
triggerall = enemynear,name != "HLR01-CANOPUS"
triggerall = enemynear,name != "D-Broly"
triggerall = !NumHelper(99999)	;最終ヘルパー
trigger1   = !NumHelper(16000)	;並列混線被弾ヘルパー1
ID = 16999
name = "H-Konsen-Dummy[BW]"
helpertype = Player
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

;--------------------------------------------------------------------------------------------------
;  並列混線被弾ヘルパーを生成。
;  並列混線ヘルパー1を生成するためのヘルパー。
;  このヘルパーの領域が並列混線ヘルパーのターゲット領域になったり,親変更のターゲット領域になる。
;  本体から呼び出すのは最初の1F目のみ。
;  親変更可能範囲のIDでなければデストロイし,最終ヘルパーから生成される。

