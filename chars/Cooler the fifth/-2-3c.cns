triggerall = !ishelper
triggerall = palno = [11,12]
trigger1 = palno = [11,12]
trigger1 = sysvar(3)
trigger1 = gametime % 60 = 0
trigger2 = palno = [11,12]
trigger2 = roundstate > 2
trigger3 = palno = [11,12]
trigger4 = !numhelper(155)
ID = 155
name = "tokitome_kaijo"
postype = p1
pos = 0, 0
stateno = 155
helpertype = player
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State -2, 時止め無視]
