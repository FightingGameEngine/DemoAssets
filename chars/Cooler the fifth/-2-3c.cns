;--------------------------------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;  最終ヘルパー生成
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;--------------------------------------------------------------------------------------------------
;  最終ヘルパーを生成。
;  ヘルパーはメモリ領域番号(デバッグ画面のCtrl+Cで見られる(59)などの番号を自分が勝手にそう呼んでいます)
;  の小さい方から処理がされるので(MoveType = Aの場合は優先的に処理されますが)普通は一番最後に
;  処理されるヘルパー。(ヘルパーが生成されたフレームは,生成されたヘルパーの方が後に行動できます)

[State -2, 最終ヘルパー]
type = Helper
triggerall = palno = 12
triggerall = !IsHelper
triggerall = enemynear,name != "OmegaTH";トムが相手の時には出さないように設定
triggerall = enemynear,name != "Xibalba"
triggerall = enemynear,name != "G-Dialga"
triggerall = enemynear,name != "Itzamna"
triggerall = enemynear,name != "Ultimate_Cell"
triggerall = enemynear,name != "Arcadia"
triggerall = enemynear,name != "Sirius"
triggerall = enemynear,name != "Kukulkan"
triggerall = enemynear,name != "HLR01-CANOPUS"
triggerall = enemynear,name != "D-Broly"
trigger1   = !NumHelper(99999)	;最終ヘルパー
ID = 99999
name = "Last[BW]"
helpertype = Player
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause = 1

;--------------------------------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;  ヘルパーステート固定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;--------------------------------------------------------------------------------------------------

[State -2, 並列混線ヘルパーステート固定]
type = SelfState
triggerall = IsHelper
trigger1   = IsHelper(16100) || IsHelper(16101) || IsHelper(16102) || IsHelper(16103)
trigger2   = IsHelper(16104) || IsHelper(16105) || IsHelper(16106) || IsHelper(16107)
trigger3   = IsHelper(16108) || IsHelper(16109) || IsHelper(16110) || IsHelper(16111)
trigger4   = IsHelper(16112) || IsHelper(16113) || IsHelper(16114) || IsHelper(16115)
trigger5   = IsHelper(16116) || IsHelper(16117) || IsHelper(16118) || IsHelper(16119)
trigger6   = IsHelper(16120) || IsHelper(16121) || IsHelper(16122) || IsHelper(16123)
value = ifelse(!sysvar(1),16100,ifelse((HitPauseTime && (sysvar(0) & 1)),7070707,16101))
ignorehitpause = 1

;--------------------------------------------------------------------------------------------------

[State -2, 並列混線被弾ヘルパーステート固定]
type = SelfState
triggerall = IsHelper
trigger1   = IsHelper(16000) || IsHelper(16001) || IsHelper(16002) || IsHelper(16003)
trigger2   = IsHelper(16004) || IsHelper(16005) || IsHelper(16006) || IsHelper(16007)
trigger3   = IsHelper(16008) || IsHelper(16009) || IsHelper(16010) || IsHelper(16011)
trigger4   = IsHelper(16012) || IsHelper(16013) || IsHelper(16014) || IsHelper(16015)
trigger5   = IsHelper(16016) || IsHelper(16017) || IsHelper(16018) || IsHelper(16019)
trigger6   = IsHelper(16020) || IsHelper(16021) || IsHelper(16022) || IsHelper(16023)
value = ifelse(Root,var(56),16001,16000)	;親変更可能領域なら通常処理へ
ignorehitpause = 1				;そうでなければID調査ステートへ

;---------------------------------------------------------------------------
;勝利演出用
[State -2, 背景の色を変えるステコン]
type = BgPalfx
triggerall = palno = 12
trigger1 = WinKo
trigger1 = Time = 0
invertall = 1
add = 30,0,20
time = -1
color = 0

;---------------------------------------------------------------------------
;ダウン時の効果音
[State -2, bounce Sound]
type = PlaySnd
trigger1 = Time = 1
trigger1 = stateno = 5100
Volume = 999999999
value = 5100, 0

[State -2, fall Sound]
type = PlaySnd
trigger1 = Time = 1
trigger1 = stateno = 5110
Volume = 999999999
value = 5110, 0

;--------------------------------------------------------------------
;残り体力が危ない時の台詞「クズごときがぁ･･･！！」（ノーマルカラー）
[State -2]
type = Helper
triggerall = NumHelper(14001) = 0
triggerall = !ishelper
trigger1 =  (palno = [1,6]) || palno = [8,9]
trigger1 = life <= 250
helpertype = normal
name = "serihu1"
ID = 14001
stateno = 14001
pos = 0,0
postype = p1    
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 9999999999999999
pausemovetime = 9999999999999999
ignorehitpause = 1
persistent = 0

