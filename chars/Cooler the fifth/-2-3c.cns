;-----------------------------------------------------------------------------
[StateDef -3]

;--------------------------------------------------------------------------------------------------

[state 0]
trigger1 = Var(38) = 1 
trigger1 = NumHelper(60005) = 0 ;This is so it will only spawn if the helper doesn't already exist.
trigger1 = alive ;This is so it will only spawn if you're not dead.
type = Helper
stateno = 60005
id = 60005
name = "Super Armor"
keyctrl = 0
ownpal = 1

[State Hel, 1]; efeitos de sangue
type = Helper
Trigger1 = p2stateno=70021
stateno = 7014
helpertype = normal ;player
pos = 0,0
postype = p2
ignorehitpause =0
id = 7014
ownpal = 1
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)
persistent=0

[State -3]
Type=Varset
Trigger1=1
var(45)=Gametime
ignorehitpause=1

[State -3, 変数の初期化]
type = Null
triggerall = !IsHelper
triggerall = !RoundState
trigger1   = var(56) := 0 || 1	;親変更可能領域フラグ
ignorehitpause = 1

;--------------------------------------------------------------------------------------------------
;  親変更ヘルパーのIDを調べ, 親変更可能かどうかを調べる。
;  マクベス氏のリーゼの記述を参考にさせて頂きました。

[State -3, 親変更ヘルパーID調査]
type = VarSet
triggerall = !IsHelper
triggerall = TeamSide = 1		;1P側限定
triggerall = NumHelper(16000) && NumHelper(16001) && NumHelper(16002)
triggerall = (Helper(16000),ID % 256 = [30,60])
triggerall = (Helper(16001),ID % 256 = [30,60])
trigger1   = (Helper(16002),ID % 256 = [30,60])
var(56) = 1	;親変更可能領域フラグを立てる
ignorehitpause = 1

;--------------------------------------------------------------------------------------------------
