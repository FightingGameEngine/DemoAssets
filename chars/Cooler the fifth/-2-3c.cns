triggerall = !ishelper
trigger1 = PalNo = 7
trigger1 = life <= 250
helpertype = normal
name = "serihu2"
ID = 14002
stateno = 14002
pos = 0,0
postype = p1    
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 9999999999999999
pausemovetime = 9999999999999999
ignorehitpause = 1
persistent = 0

;--------------------------------------------------------------------
; Random variable for random sounds
[State -2, 8];わからないけどたぶんﾀﾞﾒｰｼﾞﾎﾞｲｽ系
type = VarRandom
triggerall = Time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
v = 15
range = 0,24

;やられボイス（ノーマル）
; Play "ouch" sound A when hit light or medium
[State -2, 9];弱・中攻撃のﾀﾞﾒｰｼﾞﾎﾞｲｽ系A
type = PlaySnd
triggerall = palno != 7
triggerall = Var(15) = [0,4]
triggerall = time = 1
triggerall = stateno = 5000
triggerall = alive
triggerall = !ishelper
trigger1 = anim = 5000
trigger2 = anim = 5001
trigger3 = anim = 5010
trigger4 = anim = 5011
Volume = 999999999
value = s190, 47

