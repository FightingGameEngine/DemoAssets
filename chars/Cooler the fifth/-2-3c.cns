triggerall = !ishelper
triggerall = palno = [11,12]
trigger1 = numhelper(155)
trigger2 = palno = [11,12]
time = 9999999999999
movetime = 9999999999999
ignorehitpause = 1

[State -2, 時止め無視]
type = Superpause
triggerall = !ishelper
triggerall = palno = [11,12]
trigger1 = numhelper(155)
trigger2 = palno = [11,12]
anim = -1
time = 9999999999999
movetime = 9999999999999
unhittable = 0
darken = 0
p2defmul = 1
ignorehitpause = 1

