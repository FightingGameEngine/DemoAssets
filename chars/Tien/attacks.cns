;---------------------------Standing Weak Punch
[Statedef 203]
type = S
movetype = A
physics = S
anim = 201
juggle = 10
velset = 0
ctrl = 0
facep2 = 1

[State 0, PowerAdd]
type = PowerAdd
triggerall = !ishelper
trigger1 = time = 0
value = 20*(var(12) = 0)

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = ishelper
trigger1 = anim = 203
value = 204

[State 0, StateTypeSet]
type = StateTypeSet
triggerall = ishelper
trigger1 = 1
statetype = S       ;S,A,C,L
movetype = A        ;I,A,H
physics = N         ;A,C,S,N
;ignorehitpause =
;persistent =

[State nohit]
type = nothitby
triggerall = ishelper
trigger1 = time >= 0
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT	;para que nada golpee al helper
time = 1

[State ride]
type = HitOverride
triggerall = ishelper
trigger1 = Time = 0			;para que cuando de su golpe, pase al state que lo desaparezca inmediatamente
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 15000
time = -1

[State 200] 		;dependiendo del state de cada golpe
type = Helper
triggerall = !ishelper
trigger1 = AnimElem = 2 ;en la animación que se de el golpe
trigger1 = var(12) > 0
name = "Ten sombras" 	;el nombre que se quiera
ID = 203		;depende de la animación que se haga corresponder a cada golpe
pos = 0,0
postype = p1
stateno = 203		;depende de la animación que se haga corresponder a cada golpe
ownpal = 1


[State 0, Trans]
type = Trans
triggerall = ishelper
trigger1 = 1
trans = ADDALPHA
alpha = 0,255
;ignorehitpause =
;persistent =


[State 203, 1]
type = PlaySnd
triggerall = !ishelper
trigger1 = AnimElem = 2
value = 4,0

[State 203, 1]
type = PlaySnd
triggerall = !ishelper
trigger1 = AnimElem = 1
value = 400,2

[State 203, 2]
type = HitDef
triggerall = ishelper
trigger1 = Time = 7
trigger2 = Time = 10
attr = S, NA
damage = 20
;20*(1-(parent,var(12)>0)*0.75)

animtype = light
hitflag = MAF
guardflag = MA
sparkno = s4100
guard.sparkno = s4500
sparkxy = -20,-70
hitsound = S5,0
guardsound = S6,0
pausetime = 8,8
ground.type = high
ground.slidetime = 5
ground.hittime  = 12
ground.velocity = -4
airguard.velocity = -1.9,-.8
air.type = high
air.velocity = -1.4,-3
air.hittime = 12

[State 203, 2]
type = HitDef
triggerall = !ishelper
trigger1 = AnimElem = 2
attr = S, NA
damage = 20
;20*(1-(var(12)>0)*0.75)
animtype = light
hitflag = MAF
guardflag = MA
sparkno = s4100
guard.sparkno = s4500
sparkxy = -20,-70
hitsound = S5,0
guardsound = S6,0
pausetime = 12,12
ground.type = high
ground.slidetime = 5
ground.hittime  = 12
ground.velocity = -4
airguard.velocity = -1.9,-.8
air.type = high
air.velocity = -1.4,-3
air.hittime = 12

[State Dest]
type = destroyself
triggerall = ishelper
trigger1 = Time = 11               ; Ac?debería ir el tiempo que dura el frame que golpea
trigger2 = parent,movetype = H

[State 203, 3]
type = ChangeState
triggerall = !ishelper
trigger1 = AnimTime = 0
value = 0
ctrl = 1

