triggerall = root,var(39)= 1
trigger1=1
priority=6,Hit
attr=S,SP
damage=80,5
animtype=Hard
hitflag=MAF
guardflag=MA
pausetime= 3,8
sparkno = -1 + 0*(var(32):=8011)
sparkxy = -10 + 0*(var(35):=-30), var(36):=0
guard.sparkno=s3000
guardsound= S46,1
ground.type=High
ground.slidetime=24
ground.hittime=24
ground.velocity=ifelse(p2dist x < 3,-5,-2)
ground.cornerpush.veloff=0
air.velocity=ifelse(p2dist x < 3,-5,-2)
fall= ifelse(hitcount > 6,1,0)
air.fall=1
fall.recover=0
p2facing=1
getpower=0
envshake.time = ifelse(var(39)=1,10,0)
envshake.freq = ifelse(var(39)=1,100,0)
envshake.ampl = ifelse(var(39)=1,-5,0)
sprpriority=4

[State 3005, hitvar]
