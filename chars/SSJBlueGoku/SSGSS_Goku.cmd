;===================================================;
;                   SUPER MOVES                     ;
;===================================================;
; Supers
[State -1, Power Charge]
type = ChangeState
value = ifelse(statetype = A, 1200,1000)
triggerall = command = "Super"
triggerall = power >=2000
trigger1 = ctrl

[State -1, Power Charge]
type = ChangeState
value = 100011
triggerall = statetype != A
triggerall = command = "Super1"
triggerall = power >=2000
trigger1 = ctrl

[State -1, Power Charge]
type = ChangeState
value = 1400
triggerall = command = "Super2"
triggerall = power >=2000
trigger1 = ctrl

[State -1, Power Charge]
type = ChangeState
value = 2300
triggerall = command = "Super3"
;triggerall = power >=1000
trigger1 = ctrl

[State -1, Stand Strong Punch]
type = ChangeState
value = 151224
TriggerAll=var(59)=0
triggerall = command = "kaioken"
triggerall = statetype != A
triggerall = var(50) = 0
trigger1 = ctrl
triggerall = power >=1000

;===================================================;
;                 SPECIAL MOVES                     ;
;===================================================;

;Power Charge
[State -1, Power Charge]
type = ChangeState
value = 900
triggerall = power!=powermax
triggerall = command = "x" && command = "y"
triggerall = statetype != A
trigger1 = ctrl

[State -1, Power Charge]
type = ChangeState
value = 14251
triggerall = command = "c"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = 14251

[State -1, Power Charge]
type = ChangeState
value = 1926
trigger1 = command = "start"
triggerall = statetype != A
triggerall = ctrl
[State -1,]
type = ChangeState
value = 800
TriggerAll = Var(59) <= 0
triggerall = (command = "holdfwd" || command = "holdback") && (command = "b")
triggerall = statetype = S
triggerall = ctrl
;triggerall = stateno != 100
trigger1 = p2bodydist X < 7
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;===================================================;
;                  NORMAL MOVES                     ;
;===================================================;
; Dash Punch
[State -1, Auto Combo X]
type = ChangeState
value = 260
triggerall = command = "x"
triggerall = stateno = 100
trigger1 = ctrl

; Dash Kick
[State -1, Auto Combo Y]
type = ChangeState
value = 331
triggerall = command = "y"
triggerall = stateno = 100
trigger1 = ctrl

; Dash Ki
[State -1, Auto Combo Z]
type = ChangeState
value = 475
triggerall = command = "z"
triggerall = stateno = 100 || stateno = 105
trigger1 = ctrl

; Punch
[State -1, Auto Combo X]
type = ChangeState
value = ifelse(statetype = A,220,ifelse(statetype=C && command = "holddown",210,200))
triggerall = command = "x"
trigger1 = ctrl

; Kick
[State -1, Auto Combo Y]
type = ChangeState
value = ifelse(statetype = A,320,ifelse(statetype=C && command = "holddown",310,300))
triggerall = command = "y"
trigger1 = ctrl

; Air Z
[State -1, Auto Combo Z]
type = ChangeState
value = 440
triggerall = command = "z"
triggerall = command != "holddown"
triggerall = statetype = A
trigger1 = ctrl

; Ki Blasts
[State -1, Auto Combo Z]
type = ChangeState
value = 400
triggerall = power >=200
triggerall = command = "z"
triggerall = command != "holddown"
triggerall = statetype != A
trigger1 = ctrl

;Air Auto Combo X
[State -1, Air Auto Combo X]
type = ChangeState
value = 250
triggerall = command = "x"
triggerall = command != "holddown"
triggerall = statetype = A
trigger1 = ctrl

;Air Auto Combo Y
[State -1, Air Auto Combo Y]
type = ChangeState
value = 350
triggerall = command = "y"
triggerall = command != "holddown"
triggerall = statetype = A
trigger1 = ctrl

;Air Auto Combo Z
[State -1, Air Auto Combo Z]
type = ChangeState
value = 450
triggerall = command = "z"
triggerall = command != "holddown"
triggerall = statetype = A
trigger1 = ctrl

;===================================================;
;           MISCELLANEOUS MOVES                     ;
;===================================================;
; Run Forward
[State -1, Run Fwd]
type = ChangeState
value = ifelse(statetype = A, 101,100)
trigger1 = command = "FF"
trigger1 = ctrl

; Run Backward
[State -1, Run Back]
type = ChangeState
value = ifelse(statetype = A, 106,105)
trigger1 = command = "BB"
trigger1 = ctrl
