;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]





;アビリティ
;---------------------------------------------------------------------------

[State -2, コズミックイリュージョン確率]
type = varset
trigger1 = 1
var(1) = 100 ;0～999　0:OFF 1～999:設定確率で食らい抜け デフォ100  

;所謂食らい抜けスイッチ　攻撃も付加するので調整の際は注意
;100でも割と抜け率高め　でも抜けないときは抜けない

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, コズミックイリュージョン使用間隔]
type = varset
trigger1 = 1
var(2) = 180 ;0以上　デフォ180  

;食らい抜け制限スイッチ
;ここで設定したF数の間、食らい抜け後に連続して食らい抜けしません

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 演出省略]
type = varset
trigger1 = 1
var(4) = 0 ; 0:OFF 1:ON　デフォ0

;2・3ゲージ技の演出省略スイッチ
;OFFにするとカットイン演出が短くなってスムーズになります
;ゲージを連発する調整の時にどうぞ

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 攻撃力調整]
type = AttackMulSet
trigger1 = 1
value = 1.0 ; 1～XXX　デフォ1.0

;攻撃力を調整します
;攻撃力が低いと思ったらどうぞ

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 防御力調整]
type = DefenceMulSet
trigger1 = 1
value = 1.0 ; 1～XXX　デフォ1.0

;防御力を調整します
;防御力が低いと思ったらどうぞ
;ちなみにDefenceMulSetは1.0以下（0.5など）にすることで防御力が上がります

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, ダウン回避]
type = selfstate   ;OFFにする場合、"null;selfstate"にする
triggerall = !ishelper
triggerall = alive = 1
triggerall = stateno != 361
triggerall = pos Y > -40
trigger1 = stateno = 5100 || stateno = 5110
value = 361

;変数で管理するまでもないと思ったので、直接無効にしてください

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 憎悪]
type = poweradd
trigger1 = 1
value = 1 ; 0:OFF 0以上ならいくらでも　デフォ1

;ゲージ上昇率
;ゲジマユはあまりお勧めしない（やってもいいけど）

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 邪念Lv]
type = varset
trigger1 = roundstate = 1
var(21) = 1 ; 0:OFF Lv1～6まで　デフォ1

;詳しくはりどみ参照

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 執念Lv]
type = varset
trigger1 = roundstate = 1
var(23) = 1 ; 0:OFF Lv1～6まで　デフォ1

;詳しくはりどみ参照

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 怨念Lv]
type = varset
trigger1 = 1
var(24) = 1 ; 0:OFF Lv1～5まで　デフォ1

;詳しくはりどみ参照

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

[State -2, 怨念効果範囲]
type = varset
trigger1 = 1
var(25) = 3 ; 1:邪念のみ　2:執念のみ　3:両方　デフォ3

;1～3以外だと無効
;でもそうするぐらいなら上の怨念Lvを0にしましょう

;---------------------------------------------------------------------------




;アビリティここまで











































;---------------------------------------------------------------------------

[State -2, 怨念効果内容]
type = null;varset
trigger1 = 1
var(26) = 0 ; 1～5:数字分のLvUP　デフォ1

;現在調整中　使わないでね

;---------------------------------------------------------------------------


[State -2, デバック(変数確認)]
Type = DisplayToClipBoard
Trigger1 = 1
Text = "sysvar(2)=%d,var(3)=%d"
Params = sysvar(2),var(3)
IgnoreHitPause = 1

[State -2, 距離確認デバック]
type = null;AppendToClipboard
trigger1 = 1
text =  "P2X:%f,P2Y:%f,Vx%f,Vy%f,Py%f \n"
params = P2BodyDist x,P2BodyDist y,vel x,vel y,Pos y
IgnoreHitPause = 1




