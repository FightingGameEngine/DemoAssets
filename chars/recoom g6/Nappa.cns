;---------------------- Nappa's variable list ----------------------

; var(1):= 190 - Introduction
; var(2):= 9999 - ko sounds
; var(4):= 260 - Super Jump, 7000 - Jump Start, -2 - States that are always executed (use statedef -2), 2600 - Super Jump, 70000 - Jump Start
; var(5):= -2 - States that are always executed (use statedef -2)
; var(8):= -2 - States that are always executed (use statedef -2)
; var(9):= -2 - States that are always executed (use statedef -2)
;var(10):= -2 - States that are always executed (use statedef -2)
;var(11):= -2 - States that are always executed (use statedef -2)
;var(12):= -3
;var(13):= 6002 - custom vs series hit back - wall explod trigger (1), 6003 - custom vs series hit back - wall explod trigger (2)
;var(20):= 800 - Throw - Attempt, 810 - Throwing the opponent, 900 - TECH HIT (p1_A)
;var(21):= 810 - Throwing the opponent, 900 - TECH HIT (p1_A)
;var(23):= -2 - States that are always executed (use statedef -2)
;var(24):= -2 - States that are always executed (use statedef -2)
;var(30):= -2 - States that are always executed (use statedef -2), 4511 - Leave the stage, 4600 - Standby onscreen for Dual Hyper Attack, 4701 - Jumping into the screen first (partner), 4800 - Partner Counter Move (Going Out)
;var(31):= -2 - States that are always executed (use statedef -2)
;var(32):= -2 - States that are always executed (use statedef -2)
;var(35):= 970 - Dizzy pt.1, -3
;var(37):= 970 - Dizzy pt.1, -3
;var(42):= -2 - States that are always executed (use statedef -2)
;var(50):= -2 - States that are always executed (use statedef -2), -1
;var(51):= -2 - States that are always executed (use statedef -2)
;var(54):= 180 - Win state decider
;var(59):= -1

;---------------------- Float variable list ----------------------

; fvar(1):= -2 - States that are always executed (use statedef -2), -3
;fvar(20):= -2 - States that are always executed (use statedef -2)




; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 2000			;Amount of life to start with
attack = 30		;attack power (more is stronger)
defence = 30		;defensive power (more is stronger)
power = 2000
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 25		;Time which player lies down for, before getting up
airjuggle = 9999	;Number of points for juggling
sparkno = 2	         ;Default hit spark number for HitDefs
guard.sparkno = 40	         ;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volumescale = 100			;Volume offset (negative for softer)
IntPersistIndex = 40	         ;Variables with this index and above will not have their values
FloatPersistIndex = 60        ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 1		;Horizontal scaling factor.
yscale = 1		;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 40		;Player width (front, ground)
air.back = 38		;Player width (back, air)
air.front = 42		;Player width (front, air)
height = 60		;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 0, -105	          ;Approximate position of head
mid.pos = -3, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2.0		;Walk backward
run.fwd  = 7.6, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-9.0
jump.back = -3.7
jump.fwd = 3.2
runjump.fwd = 4.4
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5
airjump.back = -2.55
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .45
stand.friction = .89
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

;----------------------------------------------------------------------
[Quotes];English
victory1 = "Don't underestimate Nappa!"
victory2 = "See? Yer not so tough!"
victory3 = "I clobbered you good! Don't make me do it again."
victory4 = "Hahahaha! I can't stop laughing! Hahahaha!"
;----------------------------------------------------------------------

; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0
sprpriority = 2

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 54
range = 0,250

[State 180, 1]
type = ChangeState
trigger1 =Var(54) = [0,250]
value = 181

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = (time > 0) && (time <= 200)
flag = RoundNotOver

[state 181, No Life Bar]
type = assertspecial
trigger1 = Time >= 0
flag = NoBarDisplay

[State 0]
type = PlaySnd
trigger1 = Time = 10
value = s180, 0 + (random%2)

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S

; Like in vs Series, you always start with 1 power stock...
[State 190, PowerAdd]
type = PowerSet
trigger1 = time = 0
value = 1000

[State 190, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,400

[State 190, 2]
type = ChangeState
trigger1 = Var(1) = [0,200]
value = 191

[State 190, 3]
type = ChangeState
trigger1 = Var(1) = [201,400]
value = 192

