triggerall = NumPartner
triggerall = StateNo = 4512
trigger1 = !(Partner, Life)
trigger1 = (partner, stateno = 5150)
trigger1 = Life
trigger2 = roundstate >= 3
trigger2 = Win || LoseTime || WinTime || DrawGame
value = 4520



[State -3, enter the screen]
type = ChangeState
triggerall = var(30)
triggerall = NumPartner
triggerall = StateNo = 4512
trigger1 = !(Partner, Life)
trigger1 = (partner, stateno = 5150)
trigger1 = Life
trigger2 = roundstate >= 3
trigger2 = Win || LoseTime || WinTime || DrawGame
trigger3 = Partner,Life
trigger3 = Partner,Stateno = 50003
value = 4520


[State -3, wait out of the stage]
type = ChangeState
triggerall = NumPartner
trigger1 = var(30) = [2, 5]
trigger1 = RoundState = 2
trigger1 = Life && Partner, Life
trigger1 = (stateno != [1000,4000]) && (stateno != [4500,4999])
trigger1 = stateno != [5000, 5899]
value = 4511







[State -3, Set Normal Attack Value]
type = VarSet
triggerall = !var(14)
trigger1 = fvar(1) < 1
fv = 1
value = 1

[State -3, Set Attack]
type = AttackMulSet
trigger1 = 1
value = fvar(1)





