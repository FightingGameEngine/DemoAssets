; Player information
[Info]
name = "Kid Goku"        ;Name of character
displayname = "Kid Goku" ;Name of character to display
versiondate = 07,07,2013    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Gladiacloud"         ;Character author name
pal.defaults = 1      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = kid goku.cmd
cns     = kid goku.cns
st      = kid goku.cns
st1      = attacks.cns		;States
st2      = special.cns
st3      = hypers.cns		;States
stcommon = common1.cns
sprite  = kid goku.sff
anim    = kid goku.air
sound   = kid goku.snd

[Palette Keymap]
x = 1
y = 2
z = 3
a = 4
b = 5
c = 6