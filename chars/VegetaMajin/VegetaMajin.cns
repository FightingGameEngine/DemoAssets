;----------------------------------------------
;--------------------ダメージ補正----------
;----------------------------------------------

[State -2, リセット]
type = varset
trigger1 = enemy,movetype != H
trigger2 = enemy,ctrl
triggerall = time > 0
fvar(8) = 0

[State -2, 補正対象];エリアル補正
type = varadd
triggerall = movehit = 1
triggerall = hitdefattr = SCA,NA
triggerall = fvar(8) < 0.7
trigger1 = stateno = 525
trigger2 = stateno = 280
fvar(8) = 0.15+(fvar(8)*0.57);0.2)

[State -2, 攻撃力]
type = AttackMulSet
trigger1 = 1
value = 1-fvar(8);value = fvar(8)

[State -2, 限界値]
type = varset
trigger1 = fvar(8) > 0.7
fvar(8) = 0.8

[Quotes]
victory1 = "Grappling with a Saiyajin is a death wish. You can just as easily find yourself on the receiving end."
victory2 = "Pathetic!"
victory3 = "I came for a challenge, but only see weaklings!"
victory4 = "You say I'm overpowered? You're naive for thinking that a Saiyajin elite would play fair."
victory5 = "I am the prince of all Saiyans and still the strongest of them all!"
victory6 = "Is there anyone besides Kakarot worth the effort?!!"
